+	ZEND_PARSE_PARAMETERS_START(1, 2)
+		Z_PARAM_ZVAL(factory)
+		Z_PARAM_OPTIONAL
+		Z_PARAM_STR_OR_NULL(component)
+	ZEND_PARSE_PARAMETERS_END();
+
