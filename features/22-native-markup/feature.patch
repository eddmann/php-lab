+
+static void html_lazy_fragment_free(zend_object *obj)
+{
+	html_lazy_fragment *lf = html_lazy_fragment_from_obj(obj);
+	zval_ptr_dtor(&lf->thunk);
+	zval_ptr_dtor(&lf->resolved);
+	zend_object_std_dtor(&lf->std);
