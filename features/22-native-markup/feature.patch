+		Z_PARAM_STR_OR_NULL(component)
+	ZEND_PARSE_PARAMETERS_END();
+
+	if (!html_register_handler(&HTML_G(component_factories), factory, component, 1)) {
+		RETURN_THROWS();
+	}
+}
