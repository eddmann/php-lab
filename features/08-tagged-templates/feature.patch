diff --git a/Zend/zend_tagged.c b/Zend/zend_tagged.c
new file mode 100644
index 00000000..6e08987c
--- /dev/null
+++ b/Zend/zend_tagged.c
@@ -0,0 +1,66 @@
+#include "zend.h"
+#include "zend_API.h"
+#include "zend_smart_str.h"
+#include "zend_tagged.h"
+#include "zend_tagged_arginfo.h"
+
+static void sql_append_literal(smart_str *buf, zval *v)
+{
+	ZVAL_DEREF(v);
+	switch (Z_TYPE_P(v)) {
+		case IS_NULL:  smart_str_appends(buf, "NULL"); return;
+		case IS_TRUE:  smart_str_appends(buf, "TRUE"); return;
+		case IS_FALSE: smart_str_appends(buf, "FALSE"); return;
+		case IS_LONG:  smart_str_append_long(buf, Z_LVAL_P(v)); return;
+		case IS_DOUBLE: {
+			zend_string *s = zend_strpprintf(0, "%.14G", Z_DVAL_P(v));
+			smart_str_append(buf, s);
+			zend_string_release(s);
+			return;
+		}
+		default: break;
+	}
+	/* strings (and anything else, cast to string): single-quote, escape ' as '' */
+	zend_string *s = zval_get_string(v);
+	smart_str_appendc(buf, '\'');
+	const char *p = ZSTR_VAL(s), *end = p + ZSTR_LEN(s);
+	for (; p < end; p++) {
+		if (*p == '\'') {
+			smart_str_appendc(buf, '\'');
+		}
+		smart_str_appendc(buf, *p);
+	}
+	smart_str_appendc(buf, '\'');
+	zend_string_release(s);
+}
+
+ZEND_FUNCTION(sql)
+{
+	zval *strings, *values;
+	ZEND_PARSE_PARAMETERS_START(2, 2)
+		Z_PARAM_ARRAY(strings)
+		Z_PARAM_ARRAY(values)
+	ZEND_PARSE_PARAMETERS_END();
+
+	smart_str buf = {0};
+	uint32_t ns = zend_hash_num_elements(Z_ARRVAL_P(strings));
+	for (uint32_t i = 0; i < ns; i++) {
+		zval *s = zend_hash_index_find(Z_ARRVAL_P(strings), i);
+		if (s) {
+			zend_string *ss = zval_get_string(s);
+			smart_str_append(&buf, ss);
+			zend_string_release(ss);
+		}
+		zval *v = zend_hash_index_find(Z_ARRVAL_P(values), i);
+		if (v) {
+			sql_append_literal(&buf, v);
+		}
+	}
+	smart_str_0(&buf);
+	RETURN_STR(smart_str_extract(&buf));
+}
+
+void zend_register_tagged(void)
+{
+	zend_register_functions(NULL, ext_functions, NULL, MODULE_PERSISTENT);
+}
diff --git a/Zend/zend_tagged.h b/Zend/zend_tagged.h
new file mode 100644
index 00000000..41e1aa59
--- /dev/null
+++ b/Zend/zend_tagged.h
@@ -0,0 +1,20 @@
+/*
+   +----------------------------------------------------------------------+
+   | Tagged template strings — the built-in `sql` demo tag.               |
+   |                                                                      |
+   | The `tag"... {$v} ..."` syntax is pure parser sugar that lowers to   |
+   | `tag(strings[], values[])`. This file provides one demo handler,     |
+   | `sql`, that interleaves the parts with SQL-escaped values.           |
+   +----------------------------------------------------------------------+
+*/
+
+#ifndef ZEND_TAGGED_H
+#define ZEND_TAGGED_H
+
+#include "zend.h"
+
+BEGIN_EXTERN_C()
+void zend_register_tagged(void);
+END_EXTERN_C()
+
+#endif /* ZEND_TAGGED_H */
