new file mode 100644
index 00000000..b43b1e19
--- /dev/null
+++ b/Zend/tests/tagged_comprehensive.phpt
@@ -0,0 +1,50 @@
+--TEST--
+Tagged templates — parts/values split, escaping, edge holes, non-string return
+--FILE--
+<?php
+// A debug tag: shows how the parser splits constant pieces vs interpolated values.
+function dbg(array $strings, array $values): string {
+    return json_encode($strings) . " | " . json_encode($values)
+         . " | invariant=" . (count($strings) === count($values) + 1 ? "ok" : "BROKEN");
+}
+$a = 1; $b = 2;
+echo dbg"start {$a} mid {$b} end", "\n";
+echo dbg"{$a}{$b}", "\n";        // adjacent -> ["","",""]
+echo dbg"x{$a}", "\n";           // trailing empty
+echo dbg"{$a}x", "\n";           // leading empty
+echo dbg"plain", "\n";           // no interpolation
+echo dbg"nohole", "\n";
+
+// The built-in sql demo tag: escaping and literal rendering.
+$id = 5; $name = "O'Brien"; $n = null; $pi = 3.5;
+echo sql"SELECT * FROM users WHERE id = {$id} AND name = {$name}", "\n";
+echo sql"types: {$pi}, {$n}, {true}, {false}", "\n";
+echo sql"escape: {$name} twice {$name}", "\n";
+
+// A tag can return any type, not just a string.
+function pair(array $s, array $v): array { return [$s, $v]; }
+var_dump(pair"a{$a}b");
+--EXPECT--
+["start "," mid "," end"] | [1,2] | invariant=ok
+["","",""] | [1,2] | invariant=ok
+["x",""] | [1] | invariant=ok
+["","x"] | [1] | invariant=ok
+["plain"] | [] | invariant=ok
+["nohole"] | [] | invariant=ok
+SELECT * FROM users WHERE id = 5 AND name = 'O''Brien'
+types: 3.5, NULL, {true}, {false}
+escape: 'O''Brien' twice 'O''Brien'
+array(2) {
+  [0]=>
+  array(2) {
+    [0]=>
+    string(1) "a"
+    [1]=>
+    string(1) "b"
+  }
+  [1]=>
+  array(1) {
+    [0]=>
+    int(1)
+  }
+}
diff --git a/Zend/tests/tagged_template.phpt b/Zend/tests/tagged_template.phpt
new file mode 100644
index 00000000..7d9d0dd4
--- /dev/null
+++ b/Zend/tests/tagged_template.phpt
@@ -0,0 +1,45 @@
+--TEST--
+Tagged template strings — tag"..." calls tag(strings[], values[])
+--FILE--
+<?php
+function tag(array $strings, array $values): string {
+    return json_encode($strings) . " :: " . json_encode($values);
+}
+
+$x = 42;
+$y = "hi";
+
+// Constant pieces and interpolated values are separated.
+echo tag"a {$x} b {$y} c", "\n";
+
+// No interpolation: one string piece, no values.
+echo tag"plain", "\n";
+
+// Leading, trailing and adjacent interpolations get empty "" separators so that
+// count(strings) === count(values) + 1.
+$a = 1; $b = 2;
+echo tag"{$a}{$b}", "\n";
+echo tag"x{$a}", "\n";
+echo tag"{$a}x", "\n";
+
+// The built-in `sql` demo tag escapes values.
+$id = 5;
+$name = "O'Brien";
+echo sql"SELECT * FROM users WHERE id = {$id} AND name = {$name}", "\n";
+echo sql"vals {$id}, " . "n", "\n";   // composes with normal concatenation
+$n = null; $f = 2.5; $t = true;
+echo sql"a={$n} b={$f} c={$t}", "\n";
+
+// Ordinary strings and interpolation are unaffected.
+echo "normal {$x}", "\n";
+?>
+--EXPECT--
+["a "," b "," c"] :: [42,"hi"]
+["plain"] :: []
+["","",""] :: [1,2]
+["x",""] :: [1]
+["","x"] :: [1]
+SELECT * FROM users WHERE id = 5 AND name = 'O''Brien'
+vals 5, n
+a=NULL b=2.5 c=TRUE
+normal 42
diff --git a/Zend/zend_ast.c b/Zend/zend_ast.c
index 9cb3c7aa..b0cc964d 100644
--- a/Zend/zend_ast.c
+++ b/Zend/zend_ast.c
@@ -95,6 +95,52 @@ ZEND_API zend_ast * ZEND_FASTCALL zend_ast_create_zval_from_str(zend_string *str
 	return zend_ast_create_zval_int(&zv, 0, CG(zend_lineno));
 }
 
+/* Tagged template strings: `tag"a {$x} b"` -> tag(['a ', ' b'], [$x]).
+ * Splits the interpolated string into a constant-pieces array and a values
+ * array (JS-style: strings.count == values.count + 1, with empty "" pieces
+ * inserted where interpolations are adjacent or at the ends), then builds the
+ * call to `tag`. `parts` is either a single constant-string ZVAL node (no
+ * interpolation) or a ZEND_AST_ENCAPS_LIST. */
+static zend_ast *zend_ast_tt_elem(zend_ast *value) {
+	return zend_ast_create_ex(ZEND_AST_ARRAY_ELEM, 0, value, NULL);
+}
+
+static zend_ast *zend_ast_tt_empty(void) {
+	return zend_ast_create_zval_from_str(ZSTR_EMPTY_ALLOC());
+}
+
+ZEND_API zend_ast *zend_ast_create_tagged_template(zend_ast *name, zend_ast *parts) {
+	name->attr = ZEND_NAME_FQ;
+	zend_ast *strings = zend_ast_create_list(0, ZEND_AST_ARRAY);
+	zend_ast *values  = zend_ast_create_list(0, ZEND_AST_ARRAY);
+
+	if (parts->kind != ZEND_AST_ENCAPS_LIST) {
+		/* no interpolation: a single constant string piece */
+		strings = zend_ast_list_add(strings, zend_ast_tt_elem(parts));
+	} else {
+		zend_ast_list *list = zend_ast_get_list(parts);
+		for (uint32_t i = 0; i < list->children; i++) {
+			zend_ast *child = list->child[i];
+			list->child[i] = NULL; /* move ownership into strings/values */
+			if (child->kind == ZEND_AST_ZVAL) {
+				strings = zend_ast_list_add(strings, zend_ast_tt_elem(child));
+			} else {
+				if (zend_ast_get_list(strings)->children == zend_ast_get_list(values)->children) {
+					strings = zend_ast_list_add(strings, zend_ast_tt_elem(zend_ast_tt_empty()));
+				}
+				values = zend_ast_list_add(values, zend_ast_tt_elem(child));
+			}
+		}
+		if (zend_ast_get_list(strings)->children == zend_ast_get_list(values)->children) {
+			strings = zend_ast_list_add(strings, zend_ast_tt_elem(zend_ast_tt_empty()));
+		}
+		zend_ast_destroy(parts); /* children were moved out (NULLed) */
+	}
+
+	zend_ast *args = zend_ast_create_list(2, ZEND_AST_ARG_LIST, strings, values);
+	return zend_ast_create(ZEND_AST_CALL, name, args);
+}
+
 ZEND_API zend_ast * ZEND_FASTCALL zend_ast_create_zval_from_long(zend_long lval) {
 	zval zv;
 	ZVAL_LONG(&zv, lval);
