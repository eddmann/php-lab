 		zend_compile_implicit_closure_uses(&info);
 		zend_hash_destroy(&info.uses);
 	} else if (uses_ast) {
@@ -11799,6 +11802,50 @@ static void zend_compile_stmt(zend_ast *ast) /* {{{ */
 }
 /* }}} */
 
+/* --- `apply (EXPR) { STMTS }` (Kotlin-style receiver scope function) -------
+ * Runs STMTS with $this bound to EXPR — auto-capturing surrounding variables by
+ * value, like an arrow function — and evaluates to EXPR. It lowers to:
+ *
+ *     (function () { STMTS; return $this; })->call(EXPR)
+ *
+ * ->call() binds $this to the receiver and returns it, so the whole expression
+ * yields the receiver (Kotlin `apply`). Nested `apply` blocks rebind $this to
+ * their own receiver. The synthesised closure is marked ZEND_APPLY_RECEIVER_CLOSURE
+ * so the compiler imports free variables implicitly. */
+static void zend_compile_apply(znode *result, zend_ast *ast) /* {{{ */
+{
+	zend_ast *receiver = ast->child[0];
+	zend_ast *body = ast->child[1];
+
+	if (body == NULL) {
+		body = zend_ast_create_list(0, ZEND_AST_STMT_LIST);
+	}
+	/* Append `return $this;` so ->call() evaluates to the receiver. */
+	body = zend_ast_list_add(body, zend_ast_create(ZEND_AST_RETURN,
+		zend_ast_create(ZEND_AST_VAR,
+			zend_ast_create_zval_from_str(ZSTR_KNOWN(ZEND_STR_THIS)))));
+
+	/* function () { <body> } — flagged for implicit variable capture. */
+	zend_ast *closure = zend_ast_create_decl(ZEND_AST_CLOSURE, 0,
+		zend_ast_get_lineno(ast), NULL, NULL,
+		zend_ast_create_list(0, ZEND_AST_PARAM_LIST), NULL, body, NULL, NULL);
+	closure->attr = ZEND_APPLY_RECEIVER_CLOSURE;
+
+	/* (closure)->call(receiver) */
+	zend_ast *call = zend_ast_create(ZEND_AST_METHOD_CALL, closure,
+		zend_ast_create_zval_from_str(zend_string_init("call", sizeof("call") - 1, 0)),
+		zend_ast_create_list(1, ZEND_AST_ARG_LIST, receiver));
+
+	/* receiver and body are now owned by `call`; detach so destroying the apply
+	 * node does not double-free them. */
+	ast->child[0] = NULL;
+	ast->child[1] = NULL;
+
+	zend_compile_expr(result, call);
+	zend_ast_destroy(call);
+}
+/* }}} */
+
 static void zend_compile_expr_inner(znode *result, zend_ast *ast) /* {{{ */
 {
 	/* CG(zend_lineno) = ast->lineno; */
@@ -11932,6 +11979,9 @@ static void zend_compile_expr_inner(znode *result, zend_ast *ast) /* {{{ */
 		case ZEND_AST_MATCH:
 			zend_compile_match(result, ast);
 			return;
+		case ZEND_AST_APPLY:
+			zend_compile_apply(result, ast);
+			return;
 		case ZEND_AST_PIPE:
 			zend_compile_pipe(result, ast);
 			return;
