+/* Emit the rebind-and-jump for a validated recur / self tail call: evaluate
+ * ALL argument expressions into temporaries first (so recur($b, $a) reads the
+ * pre-rebind values), assign them to the parameter CVs, free enclosing loop
+ * temporaries (exactly as goto does), and jump back to the first opline after
+ * the RECVs. Constant stack — this IS tail-call elimination. */
+static void zend_emit_recur_jump(zend_ast_list *args) /* {{{ */
+{
+	zend_op_array *op_array = CG(active_op_array);
+	uint32_t num_params = op_array->num_args;
+	znode *tmps = safe_emalloc(num_params ? num_params : 1, sizeof(znode), 0);
+	uint32_t i;
+
+	for (i = 0; i < num_params; i++) {
+		znode arg_node;
+		zend_compile_expr(&arg_node, args->child[i]);
+		zend_emit_op_tmp(&tmps[i], ZEND_QM_ASSIGN, &arg_node, NULL);
+	}
+	for (i = 0; i < num_params; i++) {
+		zend_string *name = op_array->arg_info[i].name;
+		zend_ast *var_ast = zend_ast_create(ZEND_AST_VAR,
+			zend_ast_create_zval_from_str(zend_string_copy(name)));
+		zend_emit_assign_znode(var_ast, &tmps[i]);
+	}
+	efree(tmps);
+
+	zend_handle_loops_and_finally(NULL);
+
+	uint32_t target = 0;
+	while (target < op_array->last
+	 && (op_array->opcodes[target].opcode == ZEND_RECV
+	  || op_array->opcodes[target].opcode == ZEND_RECV_INIT)) {
+		target++;
+	}
+	zend_emit_jump(target);
