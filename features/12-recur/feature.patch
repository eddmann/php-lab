+/* }}} */
+
+/* Automatic TCO: `return f(...)` where f is the enclosing plain function and
+ * the call is a simple positional self-call. Conservative — any doubt means
+ * an ordinary call is emitted instead. Methods are excluded (a subclass
+ * override must keep dynamic dispatch); closures have no callable name. */
+static bool zend_try_compile_self_tco(zend_ast *expr_ast) /* {{{ */
+{
+	zend_op_array *op_array = CG(active_op_array);
+
+	if (!expr_ast || expr_ast->kind != ZEND_AST_CALL) {
+		return false;
+	}
+	if (op_array->function_name == NULL
+	 || CG(active_class_entry) != NULL
+	 || (op_array->fn_flags & (ZEND_ACC_CLOSURE|ZEND_ACC_RETURN_REFERENCE))) {
+		return false;
+	}
+
+	zend_ast *name_ast = expr_ast->child[0];
+	if (name_ast->kind != ZEND_AST_ZVAL
+	 || Z_TYPE_P(zend_ast_get_zval(name_ast)) != IS_STRING) {
+		return false;
+	}
+	zend_string *call_name = zend_ast_get_str(name_ast);
+	zend_string *fname = op_array->function_name;
+	size_t cl = ZSTR_LEN(call_name), fl = ZSTR_LEN(fname);
+
+	if (name_ast->attr == ZEND_NAME_FQ) {
+		if (cl != fl || zend_binary_strcasecmp(ZSTR_VAL(call_name), cl, ZSTR_VAL(fname), fl) != 0) {
+			return false;
+		}
+	} else if (name_ast->attr == ZEND_NAME_NOT_FQ) {
+		/* Unqualified: match the tail of the (possibly namespaced) enclosing
+		 * name. Inside namespace Foo, foo() resolves to Foo\foo first — which
+		 * is exactly the function being compiled. */
+		if (memchr(ZSTR_VAL(call_name), '\\', cl) != NULL
+		 || cl > fl
+		 || (cl < fl && ZSTR_VAL(fname)[fl - cl - 1] != '\\')
+		 || zend_binary_strcasecmp(ZSTR_VAL(call_name), cl, ZSTR_VAL(fname) + (fl - cl), cl) != 0) {
+			return false;
+		}
+	} else {
