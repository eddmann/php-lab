+/* Shared validation. When silent, any problem returns false so the caller
+ * falls back to an ordinary call; otherwise it raises the compile error. */
+static bool zend_validate_recur(zend_ast_list *args, bool silent) /* {{{ */
+{
+	zend_op_array *op_array = CG(active_op_array);
+	uint32_t i;
