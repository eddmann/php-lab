+		if (args->child[i]->kind == ZEND_AST_UNPACK) {
+			ZEND_RECUR_FAIL("recur does not support argument unpacking");
+		}
+		if (args->child[i]->kind == ZEND_AST_NAMED_ARG) {
+			ZEND_RECUR_FAIL("recur does not support named arguments");
+		}
+	}
+	for (i = 0; i < op_array->num_args; i++) {
+		if (ZEND_ARG_SEND_MODE(&op_array->arg_info[i])) {
+			ZEND_RECUR_FAIL("recur cannot rebind by-reference parameter $%s",
+				ZSTR_VAL(op_array->arg_info[i].name));
+		}
+	}
