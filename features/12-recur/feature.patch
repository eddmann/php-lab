+/* Is this AST an unqualified call to recur(...)? */
+static bool zend_ast_is_recur_call(zend_ast *ast) /* {{{ */
+{
+	if (!ast || ast->kind != ZEND_AST_CALL) {
+		return false;
+	}
+	zend_ast *name_ast = ast->child[0];
+	if (name_ast->kind != ZEND_AST_ZVAL
+	 || Z_TYPE_P(zend_ast_get_zval(name_ast)) != IS_STRING
+	 || name_ast->attr != ZEND_NAME_NOT_FQ) {
