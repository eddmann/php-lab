diff --git a/Zend/zend_option_result.c b/Zend/zend_option_result.c
new file mode 100644
index 00000000..e358e2e0
--- /dev/null
+++ b/Zend/zend_option_result.c
@@ -0,0 +1,843 @@
+/*
+   +----------------------------------------------------------------------+
+   | Built-in Option/Result types for the `?` propagation operator.       |
+   |                                                                      |
+   | Option = Some|None, Result = Ok|Err. Both implement Propagatable,    |
+   | the protocol the postfix `?` operator compiles against:              |
+   |   isFailure() -> short-circuit (return the container) when true      |
+   |   getValue()  -> unwrap the success payload                          |
+   +----------------------------------------------------------------------+
+*/
+
+#include "zend.h"
+#include "zend_API.h"
+#include "zend_interfaces.h"
+#include "zend_exceptions.h"
+#include "zend_smart_str.h"
+#include "zend_option_result.h"
+#include "zend_option_result_arginfo.h"
+
+ZEND_API zend_class_entry *zend_ce_propagatable;
+ZEND_API zend_class_entry *zend_ce_option;
+ZEND_API zend_class_entry *zend_ce_some;
+ZEND_API zend_class_entry *zend_ce_none;
+ZEND_API zend_class_entry *zend_ce_result;
+ZEND_API zend_class_entry *zend_ce_ok;
+ZEND_API zend_class_entry *zend_ce_err;
+
+#define PROP_VALUE "value"
+#define PROP_ERROR "error"
+
+static zend_always_inline bool instance_of(zval *zv, zend_class_entry *ce)
+{
+	return instanceof_function(Z_OBJCE_P(zv), ce);
+}
+
+static zend_always_inline zval *read_prop(zend_class_entry *ce, zval *obj, const char *name, size_t len, zval *rv)
+{
+	return zend_read_property(ce, Z_OBJ_P(obj), name, len, /* silent */ 0, rv);
+}
+
+/* Build `new $ce` and store $payload in $prop. */
+static void make_wrapped(zval *out, zend_class_entry *ce, const char *prop, size_t prop_len, zval *payload)
+{
+	object_init_ex(out, ce);
+	zend_update_property(ce, Z_OBJ_P(out), prop, prop_len, payload);
+}
+
+/* Call $fn($arg) into $ret. Returns SUCCESS/FAILURE. */
+static zend_result call_unary(zend_fcall_info *fci, zend_fcall_info_cache *fcc, zval *arg, zval *ret)
+{
+	zval params[1];
+	ZVAL_COPY(&params[0], arg);
+	fci->param_count = 1;
+	fci->params = params;
+	fci->named_params = NULL;
+	fci->retval = ret;
+	zend_result r = zend_call_function(fci, fcc);
+	zval_ptr_dtor(&params[0]);
+	return r;
+}
+
+/* Call $fn() into $ret. */
+static zend_result call_nullary(zend_fcall_info *fci, zend_fcall_info_cache *fcc, zval *ret)
+{
+	fci->param_count = 0;
+	fci->params = NULL;
+	fci->named_params = NULL;
+	fci->retval = ret;
+	return zend_call_function(fci, fcc);
+}
+
+/* Require $zv to be an instance of $ce, else throw and free it. Returns success. */
+static bool require_instance(zval *zv, zend_class_entry *ce, const char *what)
+{
+	if (Z_TYPE_P(zv) == IS_OBJECT && instanceof_function(Z_OBJCE_P(zv), ce)) {
+		return 1;
+	}
+	zval_ptr_dtor(zv);
+	zend_throw_error(NULL, "%s", what);
+	return 0;
+}
+
+/* Append a short, safe debug representation of $v to $str (for __toString). */
+static void append_value_repr(smart_str *str, zval *v)
+{
+	switch (Z_TYPE_P(v)) {
+		case IS_NULL:   smart_str_appends(str, "null"); break;
+		case IS_TRUE:   smart_str_appends(str, "true"); break;
+		case IS_FALSE:  smart_str_appends(str, "false"); break;
+		case IS_ARRAY:  smart_str_appends(str, "array"); break;
+		case IS_OBJECT: smart_str_append(str, Z_OBJCE_P(v)->name); break;
+		case IS_STRING: {
+			smart_str_appendc(str, '"');
+			smart_str_append(str, Z_STR_P(v));
+			smart_str_appendc(str, '"');
+			break;
+		}
+		default: {
+			zend_string *s = zval_get_string_func(v);
+			smart_str_append(str, s);
+			zend_string_release(s);
+			break;
+		}
+	}
+}
+
+/* ---------------- Option ---------------- */
+
+ZEND_METHOD(Option, some)
+{
+	zval *value;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_ZVAL(value)
+	ZEND_PARSE_PARAMETERS_END();
+	make_wrapped(return_value, zend_ce_some, PROP_VALUE, sizeof(PROP_VALUE) - 1, value);
+}
+
+ZEND_METHOD(Option, none)
+{
+	ZEND_PARSE_PARAMETERS_NONE();
+	object_init_ex(return_value, zend_ce_none);
+}
+
+ZEND_METHOD(Option, isSome)
+{
+	ZEND_PARSE_PARAMETERS_NONE();
+	RETURN_BOOL(instance_of(ZEND_THIS, zend_ce_some));
+}
+
+ZEND_METHOD(Option, isNone)
+{
+	ZEND_PARSE_PARAMETERS_NONE();
+	RETURN_BOOL(instance_of(ZEND_THIS, zend_ce_none));
+}
+
+ZEND_METHOD(Option, isFailure)
+{
+	ZEND_PARSE_PARAMETERS_NONE();
+	RETURN_BOOL(instance_of(ZEND_THIS, zend_ce_none));
+}
+
+ZEND_METHOD(Option, getValue)
+{
+	ZEND_PARSE_PARAMETERS_NONE();
+	if (instance_of(ZEND_THIS, zend_ce_some)) {
+		zval rv;
+		RETURN_COPY(read_prop(zend_ce_some, ZEND_THIS, PROP_VALUE, sizeof(PROP_VALUE) - 1, &rv));
+	}
+	zend_throw_error(NULL, "Cannot call getValue() on None");
+	RETURN_THROWS();
+}
+
+ZEND_METHOD(Option, unwrapOr)
+{
+	zval *def;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_ZVAL(def)
+	ZEND_PARSE_PARAMETERS_END();
+	if (instance_of(ZEND_THIS, zend_ce_some)) {
+		zval rv;
+		RETURN_COPY(read_prop(zend_ce_some, ZEND_THIS, PROP_VALUE, sizeof(PROP_VALUE) - 1, &rv));
+	}
+	RETURN_COPY(def);
+}
+
+ZEND_METHOD(Option, map)
+{
+	zend_fcall_info fci;
+	zend_fcall_info_cache fcc;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_FUNC(fci, fcc)
+	ZEND_PARSE_PARAMETERS_END();
+
+	if (!instance_of(ZEND_THIS, zend_ce_some)) {
+		RETURN_COPY(ZEND_THIS); /* None maps to None */
+	}
+
+	zval rv, ret;
+	zval *value = read_prop(zend_ce_some, ZEND_THIS, PROP_VALUE, sizeof(PROP_VALUE) - 1, &rv);
+	if (call_unary(&fci, &fcc, value, &ret) == SUCCESS) {
+		make_wrapped(return_value, zend_ce_some, PROP_VALUE, sizeof(PROP_VALUE) - 1, &ret);
+		zval_ptr_dtor(&ret);
+	}
+}
+
+ZEND_METHOD(Option, flatMap)
+{
+	zend_fcall_info fci;
+	zend_fcall_info_cache fcc;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_FUNC(fci, fcc)
+	ZEND_PARSE_PARAMETERS_END();
+
+	if (!instance_of(ZEND_THIS, zend_ce_some)) {
+		RETURN_COPY(ZEND_THIS);
+	}
+	zval rv, ret;
+	zval *value = read_prop(zend_ce_some, ZEND_THIS, PROP_VALUE, sizeof(PROP_VALUE) - 1, &rv);
+	if (call_unary(&fci, &fcc, value, &ret) == SUCCESS) {
+		if (!require_instance(&ret, zend_ce_option, "Option::flatMap() callback must return an Option")) {
+			RETURN_THROWS();
+		}
+		RETURN_COPY_VALUE(&ret);
+	}
+}
+
+ZEND_METHOD(Option, filter)
+{
+	zend_fcall_info fci;
+	zend_fcall_info_cache fcc;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_FUNC(fci, fcc)
+	ZEND_PARSE_PARAMETERS_END();
+
+	if (!instance_of(ZEND_THIS, zend_ce_some)) {
+		RETURN_COPY(ZEND_THIS);
+	}
+	zval rv, ret;
+	zval *value = read_prop(zend_ce_some, ZEND_THIS, PROP_VALUE, sizeof(PROP_VALUE) - 1, &rv);
+	if (call_unary(&fci, &fcc, value, &ret) == SUCCESS) {
+		bool keep = zend_is_true(&ret);
+		zval_ptr_dtor(&ret);
+		if (keep) {
+			RETURN_COPY(ZEND_THIS);
+		}
+		object_init_ex(return_value, zend_ce_none);
+	}
+}
+
+ZEND_METHOD(Option, orElse)
+{
+	zend_fcall_info fci;
+	zend_fcall_info_cache fcc;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_FUNC(fci, fcc)
+	ZEND_PARSE_PARAMETERS_END();
+
+	if (instance_of(ZEND_THIS, zend_ce_some)) {
+		RETURN_COPY(ZEND_THIS);
+	}
+	zval ret;
+	if (call_nullary(&fci, &fcc, &ret) == SUCCESS) {
+		if (!require_instance(&ret, zend_ce_option, "Option::orElse() callback must return an Option")) {
+			RETURN_THROWS();
+		}
+		RETURN_COPY_VALUE(&ret);
+	}
+}
+
+ZEND_METHOD(Option, unwrap)
+{
+	ZEND_PARSE_PARAMETERS_NONE();
+	if (instance_of(ZEND_THIS, zend_ce_some)) {
+		zval rv;
+		RETURN_COPY(read_prop(zend_ce_some, ZEND_THIS, PROP_VALUE, sizeof(PROP_VALUE) - 1, &rv));
+	}
+	zend_throw_error(NULL, "Called unwrap() on a None");
+	RETURN_THROWS();
+}
+
+ZEND_METHOD(Option, expect)
+{
+	zend_string *message;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_STR(message)
+	ZEND_PARSE_PARAMETERS_END();
+	if (instance_of(ZEND_THIS, zend_ce_some)) {
+		zval rv;
+		RETURN_COPY(read_prop(zend_ce_some, ZEND_THIS, PROP_VALUE, sizeof(PROP_VALUE) - 1, &rv));
+	}
+	zend_throw_error(NULL, "%s", ZSTR_VAL(message));
+	RETURN_THROWS();
+}
+
+ZEND_METHOD(Option, okOr)
+{
+	zval *error;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_ZVAL(error)
+	ZEND_PARSE_PARAMETERS_END();
+	if (instance_of(ZEND_THIS, zend_ce_some)) {
+		zval rv;
+		zval *value = read_prop(zend_ce_some, ZEND_THIS, PROP_VALUE, sizeof(PROP_VALUE) - 1, &rv);
+		make_wrapped(return_value, zend_ce_ok, PROP_VALUE, sizeof(PROP_VALUE) - 1, value);
+	} else {
+		make_wrapped(return_value, zend_ce_err, PROP_ERROR, sizeof(PROP_ERROR) - 1, error);
+	}
+}
+
+ZEND_METHOD(Option, toNullable)
+{
+	ZEND_PARSE_PARAMETERS_NONE();
+	if (instance_of(ZEND_THIS, zend_ce_some)) {
+		zval rv;
+		RETURN_COPY(read_prop(zend_ce_some, ZEND_THIS, PROP_VALUE, sizeof(PROP_VALUE) - 1, &rv));
+	}
+	RETURN_NULL();
+}
+
+ZEND_METHOD(Option, fromNullable)
+{
+	zval *value;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_ZVAL(value)
+	ZEND_PARSE_PARAMETERS_END();
+	if (Z_TYPE_P(value) == IS_NULL) {
+		object_init_ex(return_value, zend_ce_none);
+	} else {
+		make_wrapped(return_value, zend_ce_some, PROP_VALUE, sizeof(PROP_VALUE) - 1, value);
+	}
+}
+
+/* Sequence: all Some -> Some([values]); first None -> None. Keys are preserved. */
+ZEND_METHOD(Option, all)
+{
+	HashTable *arr;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_ARRAY_HT(arr)
+	ZEND_PARSE_PARAMETERS_END();
+
+	zval out;
+	array_init(&out);
+	zend_string *key;
+	zend_ulong idx;
+	zval *entry;
+	ZEND_HASH_FOREACH_KEY_VAL(arr, idx, key, entry) {
+		ZVAL_DEREF(entry);
+		if (Z_TYPE_P(entry) != IS_OBJECT || !instanceof_function(Z_OBJCE_P(entry), zend_ce_option)) {
+			zval_ptr_dtor(&out);
+			zend_throw_error(NULL, "Option::all() expects an array of Option");
+			RETURN_THROWS();
+		}
+		if (instanceof_function(Z_OBJCE_P(entry), zend_ce_none)) {
+			zval_ptr_dtor(&out);
+			object_init_ex(return_value, zend_ce_none);
+			return;
+		}
+		zval rv;
+		zval *v = read_prop(zend_ce_some, entry, PROP_VALUE, sizeof(PROP_VALUE) - 1, &rv);
+		Z_TRY_ADDREF_P(v);
+		if (key) {
+			zend_hash_update(Z_ARRVAL(out), key, v);
+		} else {
+			zend_hash_index_update(Z_ARRVAL(out), idx, v);
+		}
+	} ZEND_HASH_FOREACH_END();
+
+	make_wrapped(return_value, zend_ce_some, PROP_VALUE, sizeof(PROP_VALUE) - 1, &out);
+	zval_ptr_dtor(&out);
+}
+
+ZEND_METHOD(Option, __toString)
+{
+	ZEND_PARSE_PARAMETERS_NONE();
+	smart_str s = {0};
+	if (instance_of(ZEND_THIS, zend_ce_some)) {
+		zval rv;
+		zval *v = read_prop(zend_ce_some, ZEND_THIS, PROP_VALUE, sizeof(PROP_VALUE) - 1, &rv);
+		smart_str_appends(&s, "Some(");
+		append_value_repr(&s, v);
+		smart_str_appendc(&s, ')');
+	} else {
+		smart_str_appends(&s, "None");
+	}
+	smart_str_0(&s);
+	RETURN_STR(smart_str_extract(&s));
+}
+
+/* ---------------- Some / None ---------------- */
+
+ZEND_METHOD(Some, __construct)
+{
+	zval *value;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_ZVAL(value)
+	ZEND_PARSE_PARAMETERS_END();
+	zend_update_property(zend_ce_some, Z_OBJ_P(ZEND_THIS), PROP_VALUE, sizeof(PROP_VALUE) - 1, value);
+}
+
+/* ---------------- Result ---------------- */
+
+ZEND_METHOD(Result, ok)
+{
+	zval *value;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_ZVAL(value)
+	ZEND_PARSE_PARAMETERS_END();
+	make_wrapped(return_value, zend_ce_ok, PROP_VALUE, sizeof(PROP_VALUE) - 1, value);
+}
+
+ZEND_METHOD(Result, err)
+{
+	zval *error;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_ZVAL(error)
+	ZEND_PARSE_PARAMETERS_END();
+	make_wrapped(return_value, zend_ce_err, PROP_ERROR, sizeof(PROP_ERROR) - 1, error);
+}
+
+ZEND_METHOD(Result, isOk)
+{
+	ZEND_PARSE_PARAMETERS_NONE();
+	RETURN_BOOL(instance_of(ZEND_THIS, zend_ce_ok));
+}
+
+ZEND_METHOD(Result, isErr)
+{
+	ZEND_PARSE_PARAMETERS_NONE();
+	RETURN_BOOL(instance_of(ZEND_THIS, zend_ce_err));
+}
+
+ZEND_METHOD(Result, isFailure)
+{
+	ZEND_PARSE_PARAMETERS_NONE();
+	RETURN_BOOL(instance_of(ZEND_THIS, zend_ce_err));
+}
+
+ZEND_METHOD(Result, getValue)
+{
+	ZEND_PARSE_PARAMETERS_NONE();
+	if (instance_of(ZEND_THIS, zend_ce_ok)) {
+		zval rv;
+		RETURN_COPY(read_prop(zend_ce_ok, ZEND_THIS, PROP_VALUE, sizeof(PROP_VALUE) - 1, &rv));
+	}
+	zend_throw_error(NULL, "Cannot call getValue() on Err");
+	RETURN_THROWS();
+}
+
+ZEND_METHOD(Result, getError)
+{
+	ZEND_PARSE_PARAMETERS_NONE();
+	if (instance_of(ZEND_THIS, zend_ce_err)) {
+		zval rv;
+		RETURN_COPY(read_prop(zend_ce_err, ZEND_THIS, PROP_ERROR, sizeof(PROP_ERROR) - 1, &rv));
+	}
+	zend_throw_error(NULL, "Cannot call getError() on Ok");
+	RETURN_THROWS();
+}
+
+ZEND_METHOD(Result, unwrapOr)
+{
+	zval *def;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_ZVAL(def)
+	ZEND_PARSE_PARAMETERS_END();
+	if (instance_of(ZEND_THIS, zend_ce_ok)) {
+		zval rv;
+		RETURN_COPY(read_prop(zend_ce_ok, ZEND_THIS, PROP_VALUE, sizeof(PROP_VALUE) - 1, &rv));
+	}
+	RETURN_COPY(def);
+}
+
+ZEND_METHOD(Result, map)
+{
+	zend_fcall_info fci;
+	zend_fcall_info_cache fcc;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_FUNC(fci, fcc)
+	ZEND_PARSE_PARAMETERS_END();
+
+	if (!instance_of(ZEND_THIS, zend_ce_ok)) {
+		RETURN_COPY(ZEND_THIS); /* Err maps to itself */
+	}
+
+	zval rv, ret;
+	zval *value = read_prop(zend_ce_ok, ZEND_THIS, PROP_VALUE, sizeof(PROP_VALUE) - 1, &rv);
+	if (call_unary(&fci, &fcc, value, &ret) == SUCCESS) {
+		make_wrapped(return_value, zend_ce_ok, PROP_VALUE, sizeof(PROP_VALUE) - 1, &ret);
+		zval_ptr_dtor(&ret);
+	}
+}
+
+ZEND_METHOD(Result, flatMap)
+{
+	zend_fcall_info fci;
+	zend_fcall_info_cache fcc;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_FUNC(fci, fcc)
+	ZEND_PARSE_PARAMETERS_END();
+
+	if (!instance_of(ZEND_THIS, zend_ce_ok)) {
+		RETURN_COPY(ZEND_THIS); /* Err short-circuits */
+	}
+	zval rv, ret;
+	zval *value = read_prop(zend_ce_ok, ZEND_THIS, PROP_VALUE, sizeof(PROP_VALUE) - 1, &rv);
+	if (call_unary(&fci, &fcc, value, &ret) == SUCCESS) {
+		if (!require_instance(&ret, zend_ce_result, "Result::flatMap() callback must return a Result")) {
+			RETURN_THROWS();
+		}
+		RETURN_COPY_VALUE(&ret);
+	}
+}
+
+ZEND_METHOD(Result, mapErr)
+{
+	zend_fcall_info fci;
+	zend_fcall_info_cache fcc;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_FUNC(fci, fcc)
+	ZEND_PARSE_PARAMETERS_END();
+
+	if (!instance_of(ZEND_THIS, zend_ce_err)) {
+		RETURN_COPY(ZEND_THIS); /* Ok is unchanged */
+	}
+	zval rv, ret;
+	zval *error = read_prop(zend_ce_err, ZEND_THIS, PROP_ERROR, sizeof(PROP_ERROR) - 1, &rv);
+	if (call_unary(&fci, &fcc, error, &ret) == SUCCESS) {
+		make_wrapped(return_value, zend_ce_err, PROP_ERROR, sizeof(PROP_ERROR) - 1, &ret);
+		zval_ptr_dtor(&ret);
+	}
+}
+
+ZEND_METHOD(Result, orElse)
+{
+	zend_fcall_info fci;
+	zend_fcall_info_cache fcc;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_FUNC(fci, fcc)
+	ZEND_PARSE_PARAMETERS_END();
+
+	if (instance_of(ZEND_THIS, zend_ce_ok)) {
+		RETURN_COPY(ZEND_THIS);
+	}
+	zval rv, ret;
+	zval *error = read_prop(zend_ce_err, ZEND_THIS, PROP_ERROR, sizeof(PROP_ERROR) - 1, &rv);
+	if (call_unary(&fci, &fcc, error, &ret) == SUCCESS) {
+		if (!require_instance(&ret, zend_ce_result, "Result::orElse() callback must return a Result")) {
+			RETURN_THROWS();
+		}
+		RETURN_COPY_VALUE(&ret);
+	}
+}
+
+ZEND_METHOD(Result, unwrap)
+{
+	ZEND_PARSE_PARAMETERS_NONE();
+	if (instance_of(ZEND_THIS, zend_ce_ok)) {
+		zval rv;
+		RETURN_COPY(read_prop(zend_ce_ok, ZEND_THIS, PROP_VALUE, sizeof(PROP_VALUE) - 1, &rv));
+	}
+	zend_throw_error(NULL, "Called unwrap() on an Err");
+	RETURN_THROWS();
+}
+
+ZEND_METHOD(Result, expect)
+{
+	zend_string *message;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_STR(message)
+	ZEND_PARSE_PARAMETERS_END();
+	if (instance_of(ZEND_THIS, zend_ce_ok)) {
+		zval rv;
+		RETURN_COPY(read_prop(zend_ce_ok, ZEND_THIS, PROP_VALUE, sizeof(PROP_VALUE) - 1, &rv));
+	}
+	zend_throw_error(NULL, "%s", ZSTR_VAL(message));
+	RETURN_THROWS();
+}
+
+ZEND_METHOD(Result, toOption)
+{
+	ZEND_PARSE_PARAMETERS_NONE();
+	if (instance_of(ZEND_THIS, zend_ce_ok)) {
+		zval rv;
+		zval *value = read_prop(zend_ce_ok, ZEND_THIS, PROP_VALUE, sizeof(PROP_VALUE) - 1, &rv);
+		make_wrapped(return_value, zend_ce_some, PROP_VALUE, sizeof(PROP_VALUE) - 1, value);
+	} else {
+		object_init_ex(return_value, zend_ce_none);
+	}
+}
+
+ZEND_METHOD(Result, toNullable)
+{
+	ZEND_PARSE_PARAMETERS_NONE();
+	if (instance_of(ZEND_THIS, zend_ce_ok)) {
+		zval rv;
+		RETURN_COPY(read_prop(zend_ce_ok, ZEND_THIS, PROP_VALUE, sizeof(PROP_VALUE) - 1, &rv));
+	}
+	RETURN_NULL();
+}
+
+/* Run $fn(); capture any thrown Throwable into Err, otherwise wrap in Ok. */
+ZEND_METHOD(Result, try)
+{
+	zend_fcall_info fci;
+	zend_fcall_info_cache fcc;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_FUNC(fci, fcc)
+	ZEND_PARSE_PARAMETERS_END();
+
+	zval ret;
+	ZVAL_UNDEF(&ret);
+	fci.param_count = 0;
+	fci.params = NULL;
+	fci.named_params = NULL;
+	fci.retval = &ret;
+	zend_call_function(&fci, &fcc);
+
+	if (EG(exception)) {
+		zend_object *ex = EG(exception);
+		GC_ADDREF(ex);
+		zend_clear_exception();
+		zval err;
+		ZVAL_OBJ(&err, ex);
+		make_wrapped(return_value, zend_ce_err, PROP_ERROR, sizeof(PROP_ERROR) - 1, &err);
+		zval_ptr_dtor(&err);
+	} else {
+		make_wrapped(return_value, zend_ce_ok, PROP_VALUE, sizeof(PROP_VALUE) - 1, &ret);
+		zval_ptr_dtor(&ret);
+	}
+}
+
+/* Sequence: all Ok -> Ok([values]); first Err is returned as-is. Keys preserved. */
+ZEND_METHOD(Result, all)
+{
+	HashTable *arr;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_ARRAY_HT(arr)
+	ZEND_PARSE_PARAMETERS_END();
+
+	zval out;
+	array_init(&out);
+	zend_string *key;
+	zend_ulong idx;
+	zval *entry;
+	ZEND_HASH_FOREACH_KEY_VAL(arr, idx, key, entry) {
+		ZVAL_DEREF(entry);
+		if (Z_TYPE_P(entry) != IS_OBJECT || !instanceof_function(Z_OBJCE_P(entry), zend_ce_result)) {
+			zval_ptr_dtor(&out);
+			zend_throw_error(NULL, "Result::all() expects an array of Result");
+			RETURN_THROWS();
+		}
+		if (instanceof_function(Z_OBJCE_P(entry), zend_ce_err)) {
+			zval_ptr_dtor(&out);
+			RETURN_COPY(entry);
+		}
+		zval rv;
+		zval *v = read_prop(zend_ce_ok, entry, PROP_VALUE, sizeof(PROP_VALUE) - 1, &rv);
+		Z_TRY_ADDREF_P(v);
+		if (key) {
+			zend_hash_update(Z_ARRVAL(out), key, v);
+		} else {
+			zend_hash_index_update(Z_ARRVAL(out), idx, v);
+		}
+	} ZEND_HASH_FOREACH_END();
+
+	make_wrapped(return_value, zend_ce_ok, PROP_VALUE, sizeof(PROP_VALUE) - 1, &out);
+	zval_ptr_dtor(&out);
+}
+
+ZEND_METHOD(Result, __toString)
+{
+	ZEND_PARSE_PARAMETERS_NONE();
+	smart_str s = {0};
+	if (instance_of(ZEND_THIS, zend_ce_ok)) {
+		zval rv;
+		zval *v = read_prop(zend_ce_ok, ZEND_THIS, PROP_VALUE, sizeof(PROP_VALUE) - 1, &rv);
+		smart_str_appends(&s, "Ok(");
+		append_value_repr(&s, v);
+		smart_str_appendc(&s, ')');
+	} else {
+		zval rv;
+		zval *v = read_prop(zend_ce_err, ZEND_THIS, PROP_ERROR, sizeof(PROP_ERROR) - 1, &rv);
+		smart_str_appends(&s, "Err(");
+		append_value_repr(&s, v);
+		smart_str_appendc(&s, ')');
+	}
+	smart_str_0(&s);
+	RETURN_STR(smart_str_extract(&s));
+}
+
+/* ---------------- Ok / Err ---------------- */
+
+ZEND_METHOD(Ok, __construct)
+{
+	zval *value;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_ZVAL(value)
+	ZEND_PARSE_PARAMETERS_END();
+	zend_update_property(zend_ce_ok, Z_OBJ_P(ZEND_THIS), PROP_VALUE, sizeof(PROP_VALUE) - 1, value);
+}
+
+ZEND_METHOD(Err, __construct)
+{
+	zval *error;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_ZVAL(error)
+	ZEND_PARSE_PARAMETERS_END();
+	zend_update_property(zend_ce_err, Z_OBJ_P(ZEND_THIS), PROP_ERROR, sizeof(PROP_ERROR) - 1, error);
+}
+
+/* ---------------- global helper functions ---------------- */
+
+ZEND_FUNCTION(Some)
+{
+	zval *value;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_ZVAL(value)
+	ZEND_PARSE_PARAMETERS_END();
+	make_wrapped(return_value, zend_ce_some, PROP_VALUE, sizeof(PROP_VALUE) - 1, value);
+}
+
+ZEND_FUNCTION(None)
+{
+	ZEND_PARSE_PARAMETERS_NONE();
+	object_init_ex(return_value, zend_ce_none);
+}
+
+ZEND_FUNCTION(Ok)
+{
+	zval *value;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_ZVAL(value)
+	ZEND_PARSE_PARAMETERS_END();
+	make_wrapped(return_value, zend_ce_ok, PROP_VALUE, sizeof(PROP_VALUE) - 1, value);
+}
+
+ZEND_FUNCTION(Err)
+{
+	zval *error;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_ZVAL(error)
+	ZEND_PARSE_PARAMETERS_END();
+	make_wrapped(return_value, zend_ce_err, PROP_ERROR, sizeof(PROP_ERROR) - 1, error);
+}
+
+/* ---------------- for-comprehension dispatch (arrays + monads) ---------------- */
+
+typedef enum { FC_MAP, FC_FLATMAP, FC_FILTER } fc_op;
+
+/* For arrays: list-comprehension semantics (reindexed map / filter / flatten).
+ * For objects: delegate to the matching method (Option/Result and any userland
+ * type with map()/flatMap()/filter()). `method` is the lowercase method name. */
+static void fc_dispatch(INTERNAL_FUNCTION_PARAMETERS, fc_op op, const char *method)
+{
+	zval *coll, *fn;
+	ZEND_PARSE_PARAMETERS_START(2, 2)
+		Z_PARAM_ZVAL(coll)
+		Z_PARAM_ZVAL(fn)
+	ZEND_PARSE_PARAMETERS_END();
+
+	if (Z_TYPE_P(coll) == IS_ARRAY) {
+		zval out;
+		array_init(&out);
+		zval *val;
+		ZEND_HASH_FOREACH_VAL(Z_ARRVAL_P(coll), val) {
+			zval r;
+			ZVAL_DEREF(val);
+			if (call_user_function(NULL, NULL, fn, &r, 1, val) == FAILURE || EG(exception)) {
+				zval_ptr_dtor(&out);
+				RETURN_THROWS();
+			}
+			if (op == FC_FILTER) {
+				bool keep = zend_is_true(&r);
+				zval_ptr_dtor(&r);
+				if (keep) {
+					Z_TRY_ADDREF_P(val);
+					add_next_index_zval(&out, val);
+				}
+			} else if (op == FC_FLATMAP) {
+				if (Z_TYPE(r) != IS_ARRAY) {
+					zval_ptr_dtor(&r);
+					zval_ptr_dtor(&out);
+					zend_throw_error(NULL, "for-comprehension over an array expects each generator to yield an array");
+					RETURN_THROWS();
+				}
+				zval *inner;
+				ZEND_HASH_FOREACH_VAL(Z_ARRVAL(r), inner) {
+					ZVAL_DEREF(inner);
+					Z_TRY_ADDREF_P(inner);
+					add_next_index_zval(&out, inner);
+				} ZEND_HASH_FOREACH_END();
+				zval_ptr_dtor(&r);
+			} else { /* FC_MAP */
+				add_next_index_zval(&out, &r);
+			}
+		} ZEND_HASH_FOREACH_END();
+		RETURN_COPY_VALUE(&out);
+	}
+
+	if (Z_TYPE_P(coll) == IS_OBJECT) {
+		zend_class_entry *ce = Z_OBJCE_P(coll);
+		if (zend_hash_str_exists(&ce->function_table, method, strlen(method))) {
+			zend_call_method_with_1_params(Z_OBJ_P(coll), ce, NULL, method, return_value, fn);
+			return;
+		}
+	}
+
+	zend_throw_error(NULL,
+		"for-comprehension requires an array or an object with a %s() method", method);
+}
+
+ZEND_FUNCTION(__fc_map)     { fc_dispatch(INTERNAL_FUNCTION_PARAM_PASSTHRU, FC_MAP, "map"); }
+ZEND_FUNCTION(__fc_flatMap) { fc_dispatch(INTERNAL_FUNCTION_PARAM_PASSTHRU, FC_FLATMAP, "flatmap"); }
+ZEND_FUNCTION(__fc_filter)  { fc_dispatch(INTERNAL_FUNCTION_PARAM_PASSTHRU, FC_FILTER, "filter"); }
+
+ZEND_FUNCTION(__fc_pairs_to_map)
+{
+	zval *pairs;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_ARRAY(pairs)
+	ZEND_PARSE_PARAMETERS_END();
+
+	array_init(return_value);
+	zval *pair;
+	ZEND_HASH_FOREACH_VAL(Z_ARRVAL_P(pairs), pair) {
+		ZVAL_DEREF(pair);
+		if (Z_TYPE_P(pair) != IS_ARRAY) {
+			continue;
+		}
+		zval *k = zend_hash_index_find(Z_ARRVAL_P(pair), 0);
+		zval *v = zend_hash_index_find(Z_ARRVAL_P(pair), 1);
+		if (!k || !v) {
+			continue;
+		}
+		ZVAL_DEREF(k);
+		ZVAL_DEREF(v);
+		Z_TRY_ADDREF_P(v);
+		if (Z_TYPE_P(k) == IS_LONG) {
+			zend_hash_index_update(Z_ARRVAL_P(return_value), Z_LVAL_P(k), v);
+		} else {
+			zend_string *key = zval_get_string(k);
+			zend_symtable_update(Z_ARRVAL_P(return_value), key, v);
+			zend_string_release(key);
+		}
+	} ZEND_HASH_FOREACH_END();
+}
+
+/* ---------------- registration ---------------- */
+
+void zend_register_option_result(void)
+{
+	zend_ce_propagatable = register_class_Propagatable();
+
+	zend_ce_option = register_class_Option(zend_ce_propagatable);
+	zend_ce_some = register_class_Some(zend_ce_option);
+	zend_ce_none = register_class_None(zend_ce_option);
+
+	zend_ce_result = register_class_Result(zend_ce_propagatable);
+	zend_ce_ok = register_class_Ok(zend_ce_result);
+	zend_ce_err = register_class_Err(zend_ce_result);
+
+	zend_register_functions(NULL, ext_functions, NULL, MODULE_PERSISTENT);
+}
