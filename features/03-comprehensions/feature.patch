+/*
+   +----------------------------------------------------------------------+
+   | Built-in Option/Result types for the `?` propagation operator.       |
+   +----------------------------------------------------------------------+
+*/
+
+#ifndef ZEND_OPTION_RESULT_H
+#define ZEND_OPTION_RESULT_H
+
+#include "zend.h"
+
+BEGIN_EXTERN_C()
+
+extern ZEND_API zend_class_entry *zend_ce_propagatable;
+extern ZEND_API zend_class_entry *zend_ce_option;
+extern ZEND_API zend_class_entry *zend_ce_some;
+extern ZEND_API zend_class_entry *zend_ce_none;
+extern ZEND_API zend_class_entry *zend_ce_result;
+extern ZEND_API zend_class_entry *zend_ce_ok;
+extern ZEND_API zend_class_entry *zend_ce_err;
+
+void zend_register_option_result(void);
+
+END_EXTERN_C()
+
+#endif /* ZEND_OPTION_RESULT_H */
diff --git a/Zend/zend_option_result.stub.php b/Zend/zend_option_result.stub.php
new file mode 100644
index 00000000..dfb0c182
--- /dev/null
+++ b/Zend/zend_option_result.stub.php
@@ -0,0 +1,102 @@
+<?php
+
+/** @generate-class-entries */
+
+/**
+ * Implemented by any value the postfix `?` propagation operator understands.
+ * When `EXPR?` is evaluated, the engine calls isFailure(); if true it returns
+ * the value from the enclosing function, otherwise it unwraps via getValue().
+ */
+interface Propagatable
+{
+    public function isFailure(): bool;
+    public function getValue(): mixed;
+}
+
+abstract class Option implements Propagatable
+{
+    final public static function some(mixed $value): Some {}
+    final public static function none(): None {}
+    final public function isSome(): bool {}
+    final public function isNone(): bool {}
+    final public function isFailure(): bool {}
+    public function getValue(): mixed {}
+    final public function unwrapOr(mixed $default): mixed {}
+    final public function map(callable $fn): Option {}
+    final public function flatMap(callable $fn): Option {}
+    final public function filter(callable $fn): Option {}
+    final public function orElse(callable $fn): Option {}
+    final public function unwrap(): mixed {}
+    final public function expect(string $message): mixed {}
+    final public function okOr(mixed $error): Result {}
+    final public function toNullable(): mixed {}
+    final public static function fromNullable(mixed $value): Option {}
+    final public static function all(array $options): Option {}
+    public function __toString(): string {}
+}
+
+final class Some extends Option
+{
+    public mixed $value;
+    public function __construct(mixed $value) {}
+}
+
+final class None extends Option
+{
+}
+
+abstract class Result implements Propagatable
+{
+    final public static function ok(mixed $value): Ok {}
+    final public static function err(mixed $error): Err {}
+    final public function isOk(): bool {}
+    final public function isErr(): bool {}
+    final public function isFailure(): bool {}
+    public function getValue(): mixed {}
+    final public function getError(): mixed {}
+    final public function unwrapOr(mixed $default): mixed {}
+    final public function map(callable $fn): Result {}
+    final public function flatMap(callable $fn): Result {}
+    final public function mapErr(callable $fn): Result {}
+    final public function orElse(callable $fn): Result {}
+    final public function unwrap(): mixed {}
+    final public function expect(string $message): mixed {}
+    final public function toOption(): Option {}
+    final public function toNullable(): mixed {}
+    final public static function try(callable $fn): Result {}
+    final public static function all(array $results): Result {}
+    public function __toString(): string {}
+}
+
+final class Ok extends Result
+{
+    public mixed $value;
+    public function __construct(mixed $value) {}
+}
+
+final class Err extends Result
+{
+    public mixed $error;
+    public function __construct(mixed $error) {}
+}
+
+function Some(mixed $value): Some {}
+
+function None(): None {}
+
+function Ok(mixed $value): Ok {}
+
+function Err(mixed $error): Err {}
+
+/* Internal dispatch helpers for the `for {} yield` comprehension desugar — not
+ * intended to be called directly. Each works on arrays (list-comprehension
+ * semantics) or any object exposing the matching method (Option/Result/...). */
+function __fc_map(mixed $collection, callable $fn): mixed {}
+
+function __fc_flatMap(mixed $collection, callable $fn): mixed {}
+
+function __fc_filter(mixed $collection, callable $fn): mixed {}
+
+/* Folds a flat list of [key, value] pairs into an associative array (later keys
+ * win) — the final step of a `for {} yield $k => $v` dict comprehension. */
+function __fc_pairs_to_map(array $pairs): array {}
