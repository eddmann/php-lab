+	zend_op *opline;
+
+	/* Evaluate the subject once into a TMP we own. */
+	zend_compile_expr(&obj_node, obj_ast);
+	zend_emit_op_tmp(&base, ZEND_QM_ASSIGN, &obj_node, NULL);
+
+	/* result = base instanceof Class */
+	zend_emit_op_tmp(&copy, ZEND_COPY_TMP, &base, NULL);
+	zend_compile_class_ref(&class_node, class_ast,
+		ZEND_FETCH_CLASS_NO_AUTOLOAD | ZEND_FETCH_CLASS_EXCEPTION | ZEND_FETCH_CLASS_SILENT);
+	opline = zend_emit_op_tmp(result, ZEND_INSTANCEOF, &copy, NULL);
+	if (class_node.op_type == IS_CONST) {
+		opline->op2_type = IS_CONST;
+		opline->op2.constant = zend_add_class_name_literal(Z_STR(class_node.u.constant));
+		opline->extended_value = zend_alloc_cache_slot();
+	} else {
+		SET_NODE(opline->op2, &class_node);
+	}
+
+	/* if (result) $var = base->method(); */
+	zend_emit_op_tmp(&cond_node, ZEND_COPY_TMP, result, NULL);
+	uint32_t opnum_jmpz = zend_emit_cond_jump(ZEND_JMPZ, &cond_node, 0);
+
+	zend_emit_op_tmp(&copy, ZEND_COPY_TMP, &base, NULL);
+	zend_emit_propagate_method(&value_node, &copy, method);
+	zend_compile_var(&var_node, var_ast, BP_VAR_W, 0);
+	zend_emit_op(NULL, ZEND_ASSIGN, &var_node, &value_node);
+
+	/* Both branches converge here and release the subject. */
+	zend_update_jump_target_to_next(opnum_jmpz);
+	zend_emit_op(NULL, ZEND_FREE, &base, NULL);
+}
 /* }}} */
 
 static void zend_compile_include_or_eval(znode *result, zend_ast *ast) /* {{{ */
@@ -11876,6 +12315,12 @@ static void zend_compile_expr_inner(znode *result, zend_ast *ast) /* {{{ */
 		case ZEND_AST_COALESCE:
 			zend_compile_coalesce(result, ast);
 			return;
+		case ZEND_AST_PROPAGATE:
+			zend_compile_propagate(result, ast);
+			return;
+		case ZEND_AST_COMPREHENSION:
+			zend_compile_comprehension(result, ast);
+			return;
 		case ZEND_AST_ASSIGN_COALESCE:
 			zend_compile_assign_coalesce(result, ast);
 			return;
@@ -11891,6 +12336,9 @@ static void zend_compile_expr_inner(znode *result, zend_ast *ast) /* {{{ */
 		case ZEND_AST_INSTANCEOF:
 			zend_compile_instanceof(result, ast);
 			return;
+		case ZEND_AST_INSTANCEOF_BIND:
+			zend_compile_instanceof_bind(result, ast);
+			return;
 		case ZEND_AST_INCLUDE_OR_EVAL:
 			zend_compile_include_or_eval(result, ast);
 			return;
