+<?php
+
+/** @generate-class-entries */
+
+/**
+ * Backing cell for a `lazy` local variable (internal). The compiler emits
+ * `$x = new LazyCell(fn() => EXPR);` and rewrites each read of `$x` into
+ * `$x->__force()`, which evaluates the thunk once and memoises the result.
+ */
+final class LazyCell
+{
+    private mixed $thunk;
+    private mixed $value = null;
+    private bool $forcing = false;
+
+    public function __construct(\Closure $thunk) {}
+
+    public function __force(): mixed {}
+}
