@@ -11680,6 +11705,173 @@ void zend_compile_top_stmt(zend_ast *ast) /* {{{ */
 }
 /* }}} */
 
+/* --- `lazy $x = EXPR;` (Scala-style lazy val locals) ----------------------
+ * `lazy $x = EXPR;` defers EXPR until the first *read* of $x, then memoises the
+ * result. The declaration lowers to `$x = new LazyCell(fn() => EXPR)` (the arrow
+ * function captures the surrounding scope by value at the declaration point), and
+ * every subsequent read of $x is compiled into `$x->__force()`, which computes
+ * once and caches. Lazy locals are read-only: writing to one is a compile error.
+ * Names are tracked per op_array (CG(context).lazy_vars), so the marker is scoped
+ * to the declaring function and never leaks into nested closures. */
+
+static bool zend_is_lazy_var(zend_string *name)
+{
+	return CG(context).lazy_vars != NULL
+		&& zend_hash_exists(CG(context).lazy_vars, name);
+}
+
+/* Reject rebinding a lazy local itself: a `foreach` value/key target or a
+ * reference source (`&$x`). These bypass the read rewrite — the FE_FETCH /
+ * ASSIGN_REF opcode writes the CV slot directly — so without this guard they
+ * would silently defeat the read-only guarantee. Mutating *through* the value
+ * (`$x->p = v`) is still fine: there the bare var is only read (forced). */
+static void zend_reject_lazy_binding(zend_ast *var_ast)
+{
+	if (var_ast && var_ast->kind == ZEND_AST_VAR
+	 && var_ast->child[0]->kind == ZEND_AST_ZVAL
+	 && Z_TYPE_P(zend_ast_get_zval(var_ast->child[0])) == IS_STRING
+	 && zend_is_lazy_var(Z_STR_P(zend_ast_get_zval(var_ast->child[0])))) {
+		zend_error_noreturn(E_COMPILE_ERROR,
+			"Cannot modify lazy variable $%s (lazy locals are read-only)",
+			ZSTR_VAL(Z_STR_P(zend_ast_get_zval(var_ast->child[0]))));
+	}
+}
+
+static void zend_register_lazy_var(zend_string *name)
+{
+	if (!CG(context).lazy_vars) {
+		ALLOC_HASHTABLE(CG(context).lazy_vars);
+		zend_hash_init(CG(context).lazy_vars, 8, NULL, NULL, 0);
+	}
+	zend_hash_add_empty_element(CG(context).lazy_vars, name);
+}
+
+/* Build a `$name->__force()` method-call AST for a lazy read. */
+static zend_ast *zend_lazy_force_ast(zend_string *name)
+{
+	return zend_ast_create(ZEND_AST_METHOD_CALL,
+		zend_ast_create(ZEND_AST_VAR, zend_ast_create_zval_from_str(zend_string_copy(name))),
+		zend_ast_create_zval_from_str(zend_string_init("__force", sizeof("__force") - 1, 0)),
+		zend_ast_create_list(0, ZEND_AST_ARG_LIST));
+}
+
+/* Rewrite reads of already-declared lazy vars inside a lazy initializer into
+ * force-calls, so `lazy $b = $a + 1` forces $a. The initializer becomes an
+ * arrow-function body that captures the referenced cell(s) by value. Does not
+ * descend into nested scopes (declarations are special nodes). */
+static void zend_lazy_rewrite_reads(zend_ast **astp)
+{
+	zend_ast *ast = *astp;
+
+	if (ast == NULL) {
+		return;
+	}
+	if (ast->kind == ZEND_AST_VAR && ast->child[0]->kind == ZEND_AST_ZVAL
+	 && Z_TYPE_P(zend_ast_get_zval(ast->child[0])) == IS_STRING
+	 && zend_is_lazy_var(Z_STR_P(zend_ast_get_zval(ast->child[0])))) {
+		*astp = zend_lazy_force_ast(Z_STR_P(zend_ast_get_zval(ast->child[0])));
+		return;
+	}
+	if (zend_ast_is_special(ast)) {
+		return;
+	}
+	if (zend_ast_is_list(ast)) {
+		zend_ast_list *list = zend_ast_get_list(ast);
+		for (uint32_t i = 0; i < list->children; i++) {
+			zend_lazy_rewrite_reads(&list->child[i]);
+		}
+	} else {
+		uint32_t n = zend_ast_get_num_children(ast);
+		for (uint32_t i = 0; i < n; i++) {
+			zend_lazy_rewrite_reads(&ast->child[i]);
+		}
+	}
+}
+
+/* Compile a lazy read `$name` (BP_VAR_R / BP_VAR_FUNC_ARG) into `$name->__force()`.
+ * Returns true if it handled the node; errors on write/rw/unset contexts; returns
+ * false for isset()/empty() (which inspect the cell without forcing) and for any
+ * non-lazy variable. */
+static bool zend_compile_lazy_read(znode *result, zend_ast *ast, uint32_t type, bool by_ref)
+{
+	if (ast->kind != ZEND_AST_VAR || ast->child[0]->kind != ZEND_AST_ZVAL) {
+		return false;
+	}
+	zval *zv = zend_ast_get_zval(ast->child[0]);
+	if (Z_TYPE_P(zv) != IS_STRING || !zend_is_lazy_var(Z_STR_P(zv))) {
+		return false;
+	}
+	zend_string *name = Z_STR_P(zv);
+
+	if (type == BP_VAR_IS) {
+		return false; /* isset($x) / empty($x): inspect the cell, don't force */
+	}
+	if (by_ref) {
+		/* Acquiring a reference to the bare lazy var (`&$x`, a by-ref argument)
+		 * would hand out a writable alias to its slot and defeat read-only. */
+		zend_error_noreturn(E_COMPILE_ERROR,
+			"Cannot modify lazy variable $%s (lazy locals are read-only)", ZSTR_VAL(name));
+	}
+	/* Every other context forces the value: plain reads, arguments, and writes
+	 * *through* the lazy value (e.g. $x->prop = v mutates the forced object).
+	 * Direct rebinding is rejected earlier (zend_ensure_writable_variable);
+	 * foreach targets are rejected in zend_compile_foreach. */
+
+	/* Compile $name->__force(). Temporarily unmark the var so compiling the
+	 * receiver does not re-enter this hook. */
+	zend_hash_del(CG(context).lazy_vars, name);
+	zend_ast *mcall = zend_lazy_force_ast(name);
+	zend_compile_expr(result, mcall);
+	zend_ast_destroy(mcall);
+	zend_register_lazy_var(name);
+	return true;
+}
+
+static void zend_compile_lazy(zend_ast *ast) /* {{{ */
+{
+	zend_ast *var_ast = ast->child[0];
+	zend_ast *init_ast = ast->child[1];
+
+	if (var_ast->kind != ZEND_AST_VAR || var_ast->child[0]->kind != ZEND_AST_ZVAL) {
+		zend_error_noreturn(E_COMPILE_ERROR, "lazy requires a simple variable target");
+	}
+	zend_string *name = zend_string_copy(Z_STR_P(zend_ast_get_zval(var_ast->child[0])));
+
+	if (zend_is_lazy_var(name)) {
+		zend_error_noreturn(E_COMPILE_ERROR, "Cannot redeclare lazy variable $%s", ZSTR_VAL(name));
+	}
+
+	/* Force references to earlier lazy vars inside the initializer first. */
+	zend_lazy_rewrite_reads(&init_ast);
+
+	/* fn() => INIT  (auto-captures the enclosing scope by value) */
+	zend_ast *thunk = zend_ast_create_decl(ZEND_AST_ARROW_FUNC, 0,
+		zend_ast_get_lineno(init_ast), NULL, NULL,
+		zend_ast_create_list(0, ZEND_AST_PARAM_LIST), NULL, init_ast, NULL, NULL);
+	ast->child[1] = NULL; /* init_ast now owned by the thunk */
+
+	/* new LazyCell(fn() => INIT) */
+	zend_ast *cls = zend_ast_create_zval_from_str(
+		zend_string_init("LazyCell", sizeof("LazyCell") - 1, 0));
+	cls->attr = ZEND_NAME_FQ;
+	zend_ast *new_cell = zend_ast_create(ZEND_AST_NEW, cls,
+		zend_ast_create_list(1, ZEND_AST_ARG_LIST, thunk));
+
+	/* $x = new LazyCell(...) — compiled as a normal write, before $x is lazy. */
+	zend_ast *assign = zend_ast_create(ZEND_AST_ASSIGN,
+		zend_ast_create(ZEND_AST_VAR, zend_ast_create_zval_from_str(zend_string_copy(name))),
+		new_cell);
+	znode r;
+	zend_compile_expr(&r, assign);
+	zend_do_free(&r);
+	zend_ast_destroy(assign);
+
+	/* Mark $x lazy: from here, reads force the cell and writes are errors. */
+	zend_register_lazy_var(name);
+	zend_string_release(name);
+}
+/* }}} */
+
 static void zend_compile_stmt(zend_ast *ast) /* {{{ */
 {
 	if (!ast) {
@@ -11702,6 +11894,9 @@ static void zend_compile_stmt(zend_ast *ast) /* {{{ */
 		case ZEND_AST_STATIC:
 			zend_compile_static_var(ast);
 			break;
+		case ZEND_AST_LAZY:
+			zend_compile_lazy(ast);
+			break;
 		case ZEND_AST_UNSET:
 			zend_compile_unset(ast);
 			break;
@@ -11968,6 +12163,9 @@ static zend_op *zend_compile_var_inner(znode *result, zend_ast *ast, uint32_t ty
 
 	switch (ast->kind) {
 		case ZEND_AST_VAR:
+			if (CG(context).lazy_vars && zend_compile_lazy_read(result, ast, type, by_ref)) {
+				return NULL;
+			}
 			return zend_compile_simple_var(result, ast, type, 0);
 		case ZEND_AST_DIM:
 			return zend_compile_dim(result, ast, type, by_ref);
@@ -12019,6 +12217,9 @@ static zend_op *zend_delayed_compile_var(znode *result, zend_ast *ast, uint32_t
 
 	switch (ast->kind) {
 		case ZEND_AST_VAR:
+			if (CG(context).lazy_vars && zend_compile_lazy_read(result, ast, type, by_ref)) {
+				return NULL;
+			}
 			return zend_compile_simple_var(result, ast, type, 1);
 		case ZEND_AST_DIM:
 			return zend_delayed_compile_dim(result, ast, type, by_ref);
