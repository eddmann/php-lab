diff --git a/Zend/zend_lazy.c b/Zend/zend_lazy.c
new file mode 100644
index 00000000..5e4dc9ea
--- /dev/null
+++ b/Zend/zend_lazy.c
@@ -0,0 +1,83 @@
+#include "zend.h"
+#include "zend_API.h"
+#include "zend_exceptions.h"
+#include "zend_closures.h"
+#include "zend_lazy.h"
+#include "zend_lazy_arginfo.h"
+
+ZEND_API zend_class_entry *zend_ce_lazy_cell;
+
+/* Property layout (declaration order): 0 = thunk, 1 = value, 2 = forcing. */
+
+ZEND_METHOD(LazyCell, __construct)
+{
+	zval *thunk;
+
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_OBJECT_OF_CLASS(thunk, zend_ce_closure)
+	ZEND_PARSE_PARAMETERS_END();
+
+	zval *slot = OBJ_PROP_NUM(Z_OBJ_P(ZEND_THIS), 0);
+	zval_ptr_dtor(slot);
+	ZVAL_COPY(slot, thunk);
+}
+
+ZEND_METHOD(LazyCell, __force)
+{
+	ZEND_PARSE_PARAMETERS_NONE();
+
+	zend_object *obj = Z_OBJ_P(ZEND_THIS);
+	zval *thunk = OBJ_PROP_NUM(obj, 0);
+
+	/* Already forced: the thunk was released and the value cached. */
+	if (Z_TYPE_P(thunk) == IS_NULL) {
+		RETURN_COPY(OBJ_PROP_NUM(obj, 1));
+	}
+	if (Z_TYPE_P(OBJ_PROP_NUM(obj, 2)) == IS_TRUE) {
+		zend_throw_error(NULL, "Circular initialization of a lazy value");
+		RETURN_THROWS();
+	}
+
+	zend_fcall_info fci;
+	zend_fcall_info_cache fcc;
+	char *error = NULL;
+	if (zend_fcall_info_init(thunk, 0, &fci, &fcc, NULL, &error) != SUCCESS) {
+		if (error) {
+			efree(error);
+		}
+		zend_throw_error(NULL, "lazy initializer is not callable");
+		RETURN_THROWS();
+	}
+
+	ZVAL_TRUE(OBJ_PROP_NUM(obj, 2));
+
+	zval ret;
+	ZVAL_UNDEF(&ret);
+	fci.retval = &ret;
+	zend_call_function(&fci, &fcc);
+
+	/* User code ran; re-fetch the object/slots and clear the in-progress flag. */
+	obj = Z_OBJ_P(ZEND_THIS);
+	ZVAL_FALSE(OBJ_PROP_NUM(obj, 2));
+
+	if (EG(exception)) {
+		/* Leave the thunk in place so a later read may retry initialization. */
+		zval_ptr_dtor(&ret);
+		RETURN_THROWS();
+	}
+
+	/* Cache the value and drop the thunk so future reads are O(1). */
+	zval *value = OBJ_PROP_NUM(obj, 1);
+	zval_ptr_dtor(value);
+	ZVAL_COPY_VALUE(value, &ret);
+	zval *slot = OBJ_PROP_NUM(obj, 0);
+	zval_ptr_dtor(slot);
+	ZVAL_NULL(slot);
+
+	RETURN_COPY(value);
+}
+
+void zend_register_lazy(void)
+{
+	zend_ce_lazy_cell = register_class_LazyCell();
+}
