+/*
+   +----------------------------------------------------------------------+
+   | LazyCell — runtime support for `lazy` local variables.               |
+   |                                                                      |
+   | The compiler lowers `lazy $x = EXPR;` to                             |
+   |   $x = new LazyCell(fn() => EXPR);                                   |
+   | and rewrites each read of $x into `$x->__force()`, which evaluates   |
+   | the thunk once, memoises the result, and returns it thereafter.      |
+   +----------------------------------------------------------------------+
+*/
+
+#ifndef ZEND_LAZY_H
+#define ZEND_LAZY_H
+
+#include "zend.h"
+
+BEGIN_EXTERN_C()
+extern ZEND_API zend_class_entry *zend_ce_lazy_cell;
+void zend_register_lazy(void);
+END_EXTERN_C()
+
+#endif /* ZEND_LAZY_H */
