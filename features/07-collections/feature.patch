+typedef struct { smart_str *buf; bool first; } map_str_ctx;
+
+static void map_tostring_cb(zval *key, zval *val, void *ctx)
+{
+	map_str_ctx *c = (map_str_ctx *) ctx;
+	if (!c->first) smart_str_appends(c->buf, ", ");
+	c->first = false;
+	pv_append_scalar(c->buf, key);
+	smart_str_appends(c->buf, " => ");
+	pv_append_scalar(c->buf, val);
+}
