+ZEND_METHOD(Set, map)
+{
+	zend_fcall_info fci;
+	zend_fcall_info_cache fcc;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_FUNC(fci, fcc)
+	ZEND_PARSE_PARAMETERS_END();
+
+	pv_set *s = Z_PVSET_P(ZEND_THIS);
+	zval list;
+	set_to_list(s, &list);
+	set_builder b;
+	set_builder_init(&b);
+	zval *m;
+	ZEND_HASH_FOREACH_VAL(Z_ARRVAL(list), m) {
+		zval ret, arg;
+		ZVAL_COPY(&arg, m);
+		fci.param_count = 1;
+		fci.params = &arg;
+		fci.retval = &ret;
+		fci.named_params = NULL;
+		zend_result r = zend_call_function(&fci, &fcc);
+		zval_ptr_dtor(&arg);
+		if (r == SUCCESS && !EG(exception)) {
+			if (set_valid_member(&ret)) {
+				set_builder_add(&b, &ret);
+			} else {
+				zval_ptr_dtor(&ret);
+				zval_ptr_dtor(&list);
+				zval_ptr_dtor(&b.root);
+				zend_throw_error(NULL, "Set::map() callback must return a string or int");
+				RETURN_THROWS();
+			}
+		}
+		zval_ptr_dtor(&ret);
+		if (EG(exception)) { break; }
+	} ZEND_HASH_FOREACH_END();
+	zval_ptr_dtor(&list);
+	if (EG(exception)) { zval_ptr_dtor(&b.root); RETURN_THROWS(); }
+	pv_set_make(return_value, &b.root, b.size);
+}
+
+ZEND_METHOD(Set, filter)
+{
+	zend_fcall_info fci;
+	zend_fcall_info_cache fcc;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_FUNC(fci, fcc)
+	ZEND_PARSE_PARAMETERS_END();
+
+	pv_set *s = Z_PVSET_P(ZEND_THIS);
+	zval list;
+	set_to_list(s, &list);
+	set_builder b;
+	set_builder_init(&b);
+	zval *m;
+	ZEND_HASH_FOREACH_VAL(Z_ARRVAL(list), m) {
+		zval ret, arg;
+		ZVAL_COPY(&arg, m);
+		fci.param_count = 1;
+		fci.params = &arg;
+		fci.retval = &ret;
+		fci.named_params = NULL;
+		zend_result r = zend_call_function(&fci, &fcc);
+		zval_ptr_dtor(&arg);
+		if (r == SUCCESS && !EG(exception) && zend_is_true(&ret)) {
+			set_builder_add(&b, m);
+		}
+		zval_ptr_dtor(&ret);
+		if (EG(exception)) { break; }
+	} ZEND_HASH_FOREACH_END();
+	zval_ptr_dtor(&list);
+	if (EG(exception)) { zval_ptr_dtor(&b.root); RETURN_THROWS(); }
+	pv_set_make(return_value, &b.root, b.size);
+}
+
+ZEND_METHOD(Set, toArray)
+{
+	ZEND_PARSE_PARAMETERS_NONE();
