diff --git a/Zend/zend_persistent.c b/Zend/zend_persistent.c
new file mode 100644
index 00000000..81c8e72b
--- /dev/null
+++ b/Zend/zend_persistent.c
@@ -0,0 +1,1697 @@
+/*
+   +----------------------------------------------------------------------+
+   | Built-in persistent (immutable, structurally-shared) collections.    |
+   |                                                                      |
+   | Vector is a bit-partitioned trie (branching factor 32). Each trie    |
+   | node is an ordinary (refcounted, COW) zend_array, so structural      |
+   | sharing, recursive free, and GC all come from the engine: a path     |
+   | copy is `zend_array_dup` of just the spine — untouched sibling       |
+   | subtrees are refcount-bumped (shared), not deep-copied.              |
+   +----------------------------------------------------------------------+
+*/
+
+#include "zend.h"
+#include "zend_API.h"
+#include "zend_interfaces.h"
+#include "zend_exceptions.h"
+#include "zend_smart_str.h"
+#include "zend_persistent.h"
+#include "zend_persistent_arginfo.h"
+
+ZEND_API zend_class_entry *zend_ce_persistent_vector;
+
+#define PV_BITS  5
+#define PV_WIDTH 32
+#define PV_MASK  31
+
+/* ---------------- object plumbing ---------------- */
+
+typedef struct {
+	zval        root;   /* IS_ARRAY: the trie root node */
+	uint32_t    size;   /* number of elements */
+	uint32_t    shift;  /* 5 * (height - 1); 0 when the root is a leaf */
+	zend_object std;
+} pv_vector;
+
+static zend_object_handlers pv_vector_handlers;
+
+static zend_always_inline pv_vector *pv_from_obj(zend_object *obj)
+{
+	return (pv_vector *)((char *)(obj) - XtOffsetOf(pv_vector, std));
+}
+#define Z_PVVEC_P(zv) pv_from_obj(Z_OBJ_P(zv))
+
+static zend_object *pv_vector_create(zend_class_entry *ce)
+{
+	pv_vector *v = zend_object_alloc(sizeof(pv_vector), ce);
+	zend_object_std_init(&v->std, ce);
+	object_properties_init(&v->std, ce);
+	ZVAL_ARR(&v->root, zend_new_array(0));
+	v->size = 0;
+	v->shift = 0;
+	v->std.handlers = &pv_vector_handlers;
+	return &v->std;
+}
+
+static void pv_vector_free(zend_object *obj)
+{
+	pv_vector *v = pv_from_obj(obj);
+	zval_ptr_dtor(&v->root);
+	zend_object_std_dtor(&v->std);
+}
+
+static zend_object *pv_vector_clone(zend_object *obj)
+{
+	pv_vector *src = pv_from_obj(obj);
+	zend_object *new_obj = pv_vector_create(obj->ce);
+	pv_vector *dst = pv_from_obj(new_obj);
+	zval_ptr_dtor(&dst->root);
+	ZVAL_COPY(&dst->root, &src->root); /* share the trie */
+	dst->size = src->size;
+	dst->shift = src->shift;
+	return new_obj;
+}
+
+static HashTable *pv_vector_get_gc(zend_object *obj, zval **table, int *n)
+{
+	pv_vector *v = pv_from_obj(obj);
+	*table = &v->root;
+	*n = 1;
+	return NULL;
+}
+
+/* Build a Vector object from an owned (root, size, shift) triple. Takes
+ * ownership of *root (no refcount change). */
+static void pv_make(zval *out, zval *root, uint32_t size, uint32_t shift)
+{
+	object_init_ex(out, zend_ce_persistent_vector);
+	pv_vector *v = Z_PVVEC_P(out);
+	zval_ptr_dtor(&v->root);
+	ZVAL_COPY_VALUE(&v->root, root);
+	v->size = size;
+	v->shift = shift;
+}
+
+/* ---------------- trie operations ---------------- */
+
+/* element at logical index i (caller guarantees i < size) */
+static zval *pv_trie_get(pv_vector *v, uint32_t i)
+{
+	zend_array *node = Z_ARR(v->root);
+	for (uint32_t s = v->shift; s > 0; s -= PV_BITS) {
+		zval *childz = zend_hash_index_find(node, (i >> s) & PV_MASK);
+		node = Z_ARR_P(childz);
+	}
+	return zend_hash_index_find(node, i & PV_MASK);
+}
+
+/* Path-copy: return a fresh (refcount 1) node equal to `node` but with logical
+ * index i set to *val. Intermediate nodes are created as needed (so this also
+ * handles appending at index == size). */
+static zend_array *pv_trie_assoc(zend_array *node, uint32_t shift, uint32_t i, zval *val)
+{
+	zend_array *copy = node ? zend_array_dup(node) : zend_new_array(1);
+	uint32_t slot = (i >> shift) & PV_MASK;
+	if (shift == 0) {
+		Z_TRY_ADDREF_P(val);
+		zend_hash_index_update(copy, slot, val);
+	} else {
+		zval *childz = node ? zend_hash_index_find(node, slot) : NULL;
+		zend_array *child = childz ? Z_ARR_P(childz) : NULL;
+		zend_array *newchild = pv_trie_assoc(child, shift - PV_BITS, i, val);
+		zval cz;
+		ZVAL_ARR(&cz, newchild);
+		zend_hash_index_update(copy, slot, &cz);
+	}
+	return copy;
+}
+
+/* Path-copy removing the last logical index i (== size-1). */
+static zend_array *pv_trie_pop(zend_array *node, uint32_t shift, uint32_t i)
+{
+	zend_array *copy = zend_array_dup(node);
+	uint32_t slot = (i >> shift) & PV_MASK;
+	if (shift == 0) {
+		zend_hash_index_del(copy, slot);
+	} else {
+		zval *childz = zend_hash_index_find(node, slot);
+		zend_array *newchild = pv_trie_pop(Z_ARR_P(childz), shift - PV_BITS, i);
+		if (zend_hash_num_elements(newchild) == 0) {
+			zend_array_release(newchild);
+			zend_hash_index_del(copy, slot);
+		} else {
+			zval cz;
+			ZVAL_ARR(&cz, newchild);
+			zend_hash_index_update(copy, slot, &cz);
+		}
+	}
+	return copy;
+}
+
+/* In-place builder used to construct vectors element-by-element. */
+typedef struct { zval root; uint32_t size; uint32_t shift; } pv_builder;
+
+static void pv_builder_init(pv_builder *b)
+{
+	ZVAL_ARR(&b->root, zend_new_array(0));
+	b->size = 0;
+	b->shift = 0;
+}
+
+static void pv_builder_push(pv_builder *b, zval *val)
+{
+	if (b->size == 0) {
+		zend_array *leaf = zend_new_array(1);
+		Z_TRY_ADDREF_P(val);
+		zend_hash_index_add_new(leaf, 0, val);
+		zval_ptr_dtor(&b->root);
+		ZVAL_ARR(&b->root, leaf);
+		b->size = 1;
+		return;
+	}
+	uint32_t cap = 1u << (b->shift + PV_BITS);
+	if (b->size == cap) {
+		/* root full: add a level, old root becomes child 0 */
+		zend_array *nr = zend_new_array(2);
+		zend_hash_index_add_new(nr, 0, &b->root); /* moves ownership */
+		ZVAL_ARR(&b->root, nr);
+		b->shift += PV_BITS;
+	}
+	zend_array *newroot = pv_trie_assoc(Z_ARR(b->root), b->shift, b->size, val);
+	zval_ptr_dtor(&b->root);
+	ZVAL_ARR(&b->root, newroot);
+	b->size++;
+}
+
+/* Append every element of the trie (in order) to a flat output array. */
+static void pv_collect(zend_array *node, uint32_t shift, zend_array *out)
+{
+	zval *z;
+	if (shift == 0) {
+		ZEND_HASH_FOREACH_VAL(node, z) {
+			Z_TRY_ADDREF_P(z);
+			zend_hash_next_index_insert(out, z);
+		} ZEND_HASH_FOREACH_END();
+	} else {
+		ZEND_HASH_FOREACH_VAL(node, z) {
+			pv_collect(Z_ARR_P(z), shift - PV_BITS, out);
+		} ZEND_HASH_FOREACH_END();
+	}
+}
+
+static void pv_to_zend_array(pv_vector *v, zval *out)
+{
+	zend_array *arr = zend_new_array(v->size);
+	if (v->size) {
+		pv_collect(Z_ARR(v->root), v->shift, arr);
+	}
+	ZVAL_ARR(out, arr);
+}
+
+/* ---------------- methods ---------------- */
+
+static void pv_throw_range(zend_long index, uint32_t size)
+{
+	zend_throw_error(NULL, "Vector index " ZEND_LONG_FMT " is out of range [0, %u)", index, size);
+}
+
+ZEND_METHOD(Vector, __construct)
+{
+	zval *values = NULL;
+	ZEND_PARSE_PARAMETERS_START(0, 1)
+		Z_PARAM_OPTIONAL
+		Z_PARAM_ARRAY(values)
+	ZEND_PARSE_PARAMETERS_END();
+
+	if (!values || zend_hash_num_elements(Z_ARRVAL_P(values)) == 0) {
+		return;
+	}
+
+	pv_vector *self = Z_PVVEC_P(ZEND_THIS);
+	pv_builder b;
+	pv_builder_init(&b);
+
+	zval *v;
+	ZEND_HASH_FOREACH_VAL(Z_ARRVAL_P(values), v) {
+		ZVAL_DEREF(v);
+		pv_builder_push(&b, v);
+	} ZEND_HASH_FOREACH_END();
+
+	zval_ptr_dtor(&self->root);
+	ZVAL_COPY_VALUE(&self->root, &b.root);
+	self->size = b.size;
+	self->shift = b.shift;
+}
+
+ZEND_METHOD(Vector, of)
+{
+	zval *args;
+	uint32_t argc;
+	ZEND_PARSE_PARAMETERS_START(0, -1)
+		Z_PARAM_VARIADIC('+', args, argc)
+	ZEND_PARSE_PARAMETERS_END();
+
+	pv_builder b;
+	pv_builder_init(&b);
+	for (uint32_t i = 0; i < argc; i++) {
+		pv_builder_push(&b, &args[i]);
+	}
+	pv_make(return_value, &b.root, b.size, b.shift);
+}
+
+ZEND_METHOD(Vector, fromArray)
+{
+	zval *arr;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_ARRAY(arr)
+	ZEND_PARSE_PARAMETERS_END();
+
+	pv_builder b;
+	pv_builder_init(&b);
+	zval *v;
+	ZEND_HASH_FOREACH_VAL(Z_ARRVAL_P(arr), v) {
+		ZVAL_DEREF(v);
+		pv_builder_push(&b, v);
+	} ZEND_HASH_FOREACH_END();
+	pv_make(return_value, &b.root, b.size, b.shift);
+}
+
+ZEND_METHOD(Vector, count)
+{
+	ZEND_PARSE_PARAMETERS_NONE();
+	RETURN_LONG(Z_PVVEC_P(ZEND_THIS)->size);
+}
+
+ZEND_METHOD(Vector, isEmpty)
+{
+	ZEND_PARSE_PARAMETERS_NONE();
+	RETURN_BOOL(Z_PVVEC_P(ZEND_THIS)->size == 0);
+}
+
+ZEND_METHOD(Vector, get)
+{
+	zend_long index;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_LONG(index)
+	ZEND_PARSE_PARAMETERS_END();
+
+	pv_vector *v = Z_PVVEC_P(ZEND_THIS);
+	if (index < 0 || (uint32_t)index >= v->size) {
+		pv_throw_range(index, v->size);
+		RETURN_THROWS();
+	}
+	zval *zv = pv_trie_get(v, (uint32_t)index);
+	RETURN_COPY_DEREF(zv);
+}
+
+ZEND_METHOD(Vector, first)
+{
+	ZEND_PARSE_PARAMETERS_NONE();
+	pv_vector *v = Z_PVVEC_P(ZEND_THIS);
+	if (v->size == 0) {
+		zend_throw_error(NULL, "Cannot get first() of an empty Vector");
+		RETURN_THROWS();
+	}
+	RETURN_COPY_DEREF(pv_trie_get(v, 0));
+}
+
+ZEND_METHOD(Vector, last)
+{
+	ZEND_PARSE_PARAMETERS_NONE();
+	pv_vector *v = Z_PVVEC_P(ZEND_THIS);
+	if (v->size == 0) {
+		zend_throw_error(NULL, "Cannot get last() of an empty Vector");
+		RETURN_THROWS();
+	}
+	RETURN_COPY_DEREF(pv_trie_get(v, v->size - 1));
+}
+
+ZEND_METHOD(Vector, push)
+{
+	zval *val;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_ZVAL(val)
+	ZEND_PARSE_PARAMETERS_END();
+
+	pv_vector *v = Z_PVVEC_P(ZEND_THIS);
+	pv_builder b;
+	b.root = v->root;
+	Z_TRY_ADDREF(b.root);
+	b.size = v->size;
+	b.shift = v->shift;
+	pv_builder_push(&b, val);
+	pv_make(return_value, &b.root, b.size, b.shift);
+}
+
+ZEND_METHOD(Vector, pop)
+{
+	ZEND_PARSE_PARAMETERS_NONE();
+	pv_vector *v = Z_PVVEC_P(ZEND_THIS);
+	if (v->size == 0) {
+		zend_throw_error(NULL, "Cannot pop() an empty Vector");
+		RETURN_THROWS();
+	}
+	if (v->size == 1) {
+		zval empty;
+		ZVAL_ARR(&empty, zend_new_array(0));
+		pv_make(return_value, &empty, 0, 0);
+		return;
+	}
+	zend_array *newroot = pv_trie_pop(Z_ARR(v->root), v->shift, v->size - 1);
+	uint32_t shift = v->shift;
+	while (shift > 0 && zend_hash_num_elements(newroot) == 1) {
+		zval *only = zend_hash_index_find(newroot, 0);
+		zend_array *child = Z_ARR_P(only);
+		GC_ADDREF(child);
+		zend_array_release(newroot);
+		newroot = child;
+		shift -= PV_BITS;
+	}
+	zval rootz;
+	ZVAL_ARR(&rootz, newroot);
+	pv_make(return_value, &rootz, v->size - 1, shift);
+}
+
+ZEND_METHOD(Vector, set)
+{
+	zend_long index;
+	zval *val;
+	ZEND_PARSE_PARAMETERS_START(2, 2)
+		Z_PARAM_LONG(index)
+		Z_PARAM_ZVAL(val)
+	ZEND_PARSE_PARAMETERS_END();
+
+	pv_vector *v = Z_PVVEC_P(ZEND_THIS);
+	if (index < 0 || (uint32_t)index >= v->size) {
+		pv_throw_range(index, v->size);
+		RETURN_THROWS();
+	}
+	zend_array *newroot = pv_trie_assoc(Z_ARR(v->root), v->shift, (uint32_t)index, val);
+	zval rootz;
+	ZVAL_ARR(&rootz, newroot);
+	pv_make(return_value, &rootz, v->size, v->shift);
+}
+
+ZEND_METHOD(Vector, toArray)
+{
+	ZEND_PARSE_PARAMETERS_NONE();
+	pv_to_zend_array(Z_PVVEC_P(ZEND_THIS), return_value);
+}
+
+ZEND_METHOD(Vector, map)
+{
+	zend_fcall_info fci;
+	zend_fcall_info_cache fcc;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_FUNC(fci, fcc)
+	ZEND_PARSE_PARAMETERS_END();
+
+	pv_vector *v = Z_PVVEC_P(ZEND_THIS);
+	zval flat;
+	pv_to_zend_array(v, &flat);
+
+	pv_builder b;
+	pv_builder_init(&b);
+	zval *elem;
+	ZEND_HASH_FOREACH_VAL(Z_ARRVAL(flat), elem) {
+		zval ret, arg;
+		ZVAL_COPY(&arg, elem);
+		fci.param_count = 1;
+		fci.params = &arg;
+		fci.retval = &ret;
+		fci.named_params = NULL;
+		if (zend_call_function(&fci, &fcc) == SUCCESS && !EG(exception)) {
+			pv_builder_push(&b, &ret);
+		}
+		zval_ptr_dtor(&arg);
+		zval_ptr_dtor(&ret);
+		if (EG(exception)) {
+			break;
+		}
+	} ZEND_HASH_FOREACH_END();
+	zval_ptr_dtor(&flat);
+	if (EG(exception)) {
+		zval_ptr_dtor(&b.root);
+		RETURN_THROWS();
+	}
+	pv_make(return_value, &b.root, b.size, b.shift);
+}
+
+ZEND_METHOD(Vector, filter)
+{
+	zend_fcall_info fci;
+	zend_fcall_info_cache fcc;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_FUNC(fci, fcc)
+	ZEND_PARSE_PARAMETERS_END();
+
+	pv_vector *v = Z_PVVEC_P(ZEND_THIS);
+	zval flat;
+	pv_to_zend_array(v, &flat);
+
+	pv_builder b;
+	pv_builder_init(&b);
+	zval *elem;
+	ZEND_HASH_FOREACH_VAL(Z_ARRVAL(flat), elem) {
+		zval ret, arg;
+		ZVAL_COPY(&arg, elem);
+		fci.param_count = 1;
+		fci.params = &arg;
+		fci.retval = &ret;
+		fci.named_params = NULL;
+		if (zend_call_function(&fci, &fcc) == SUCCESS && !EG(exception) && zend_is_true(&ret)) {
+			pv_builder_push(&b, elem);
+		}
+		zval_ptr_dtor(&arg);
+		zval_ptr_dtor(&ret);
+		if (EG(exception)) {
+			break;
+		}
+	} ZEND_HASH_FOREACH_END();
+	zval_ptr_dtor(&flat);
+	if (EG(exception)) {
+		zval_ptr_dtor(&b.root);
+		RETURN_THROWS();
+	}
+	pv_make(return_value, &b.root, b.size, b.shift);
+}
+
+ZEND_METHOD(Vector, reduce)
+{
+	zend_fcall_info fci;
+	zend_fcall_info_cache fcc;
+	zval *initial = NULL;
+	ZEND_PARSE_PARAMETERS_START(1, 2)
+		Z_PARAM_FUNC(fci, fcc)
+		Z_PARAM_OPTIONAL
+		Z_PARAM_ZVAL(initial)
+	ZEND_PARSE_PARAMETERS_END();
+
+	pv_vector *v = Z_PVVEC_P(ZEND_THIS);
+	zval acc;
+	if (initial) {
+		ZVAL_COPY(&acc, initial);
+	} else {
+		ZVAL_NULL(&acc);
+	}
+
+	zval flat;
+	pv_to_zend_array(v, &flat);
+	zval *elem;
+	ZEND_HASH_FOREACH_VAL(Z_ARRVAL(flat), elem) {
+		zval ret, args[2];
+		ZVAL_COPY(&args[0], &acc);
+		ZVAL_COPY(&args[1], elem);
+		fci.param_count = 2;
+		fci.params = args;
+		fci.retval = &ret;
+		fci.named_params = NULL;
+		zend_result r = zend_call_function(&fci, &fcc);
+		zval_ptr_dtor(&args[0]);
+		zval_ptr_dtor(&args[1]);
+		if (r == SUCCESS && !EG(exception)) {
+			zval_ptr_dtor(&acc);
+			ZVAL_COPY_VALUE(&acc, &ret);
+		} else {
+			zval_ptr_dtor(&ret);
+			break;
+		}
+	} ZEND_HASH_FOREACH_END();
+	zval_ptr_dtor(&flat);
+	if (EG(exception)) {
+		zval_ptr_dtor(&acc);
+		RETURN_THROWS();
+	}
+	RETURN_COPY_VALUE(&acc);
+}
+
+ZEND_METHOD(Vector, slice)
+{
+	zend_long offset;
+	zend_long length;
+	bool length_is_null = true;
+	ZEND_PARSE_PARAMETERS_START(1, 2)
+		Z_PARAM_LONG(offset)
+		Z_PARAM_OPTIONAL
+		Z_PARAM_LONG_OR_NULL(length, length_is_null)
+	ZEND_PARSE_PARAMETERS_END();
+
+	pv_vector *v = Z_PVVEC_P(ZEND_THIS);
+	zend_long size = v->size;
+	if (offset < 0) {
+		offset = size + offset;
+		if (offset < 0) offset = 0;
+	}
+	if (offset > size) offset = size;
+	zend_long end = length_is_null ? size : (offset + (length < 0 ? size + length - offset : length));
+	if (end > size) end = size;
+	if (end < offset) end = offset;
+
+	pv_builder b;
+	pv_builder_init(&b);
+	for (zend_long i = offset; i < end; i++) {
+		pv_builder_push(&b, pv_trie_get(v, (uint32_t)i));
+	}
+	pv_make(return_value, &b.root, b.size, b.shift);
+}
+
+static void pv_concat_into(pv_builder *b, pv_vector *v)
+{
+	if (v->size == 0) {
+		return;
+	}
+	zval flat;
+	pv_to_zend_array(v, &flat);
+	zval *elem;
+	ZEND_HASH_FOREACH_VAL(Z_ARRVAL(flat), elem) {
+		pv_builder_push(b, elem);
+	} ZEND_HASH_FOREACH_END();
+	zval_ptr_dtor(&flat);
+}
+
+ZEND_METHOD(Vector, concat)
+{
+	zval *other;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_OBJECT_OF_CLASS(other, zend_ce_persistent_vector)
+	ZEND_PARSE_PARAMETERS_END();
+
+	pv_builder b;
+	pv_builder_init(&b);
+	pv_concat_into(&b, Z_PVVEC_P(ZEND_THIS));
+	pv_concat_into(&b, Z_PVVEC_P(other));
+	pv_make(return_value, &b.root, b.size, b.shift);
+}
+
+static void pv_append_scalar(smart_str *buf, zval *zv)
+{
+	ZVAL_DEREF(zv);
+	switch (Z_TYPE_P(zv)) {
+		case IS_NULL: smart_str_appends(buf, "null"); break;
+		case IS_TRUE: smart_str_appends(buf, "true"); break;
+		case IS_FALSE: smart_str_appends(buf, "false"); break;
+		case IS_LONG: smart_str_append_long(buf, Z_LVAL_P(zv)); break;
+		case IS_STRING:
+			smart_str_appendc(buf, '"');
+			smart_str_append(buf, Z_STR_P(zv));
+			smart_str_appendc(buf, '"');
+			break;
+		case IS_DOUBLE: {
+			zend_string *s = zend_strpprintf(0, "%.14G", Z_DVAL_P(zv));
+			smart_str_append(buf, s);
+			zend_string_release(s);
+			break;
+		}
+		default:
+			smart_str_appends(buf, zend_zval_type_name(zv));
+			break;
+	}
+}
+
+ZEND_METHOD(Vector, __toString)
+{
+	ZEND_PARSE_PARAMETERS_NONE();
+	pv_vector *v = Z_PVVEC_P(ZEND_THIS);
+	smart_str buf = {0};
+	smart_str_appends(&buf, "Vector(");
+	if (v->size) {
+		zval flat;
+		pv_to_zend_array(v, &flat);
+		bool first = true;
+		zval *elem;
+		ZEND_HASH_FOREACH_VAL(Z_ARRVAL(flat), elem) {
+			if (!first) smart_str_appends(&buf, ", ");
+			first = false;
+			pv_append_scalar(&buf, elem);
+		} ZEND_HASH_FOREACH_END();
+		zval_ptr_dtor(&flat);
+	}
+	smart_str_appendc(&buf, ')');
+	smart_str_0(&buf);
+	RETURN_STR(smart_str_extract(&buf));
+}
+
+ZEND_METHOD(Vector, getIterator)
+{
+	ZEND_PARSE_PARAMETERS_NONE();
+	zval arr;
+	pv_to_zend_array(Z_PVVEC_P(ZEND_THIS), &arr);
+
+	zend_string *name = zend_string_init("ArrayIterator", sizeof("ArrayIterator") - 1, 0);
+	zend_class_entry *ce_it = zend_lookup_class(name);
+	zend_string_release(name);
+	if (!ce_it) {
+		zval_ptr_dtor(&arr);
+		zend_throw_error(NULL, "ArrayIterator is not available");
+		RETURN_THROWS();
+	}
+	object_init_ex(return_value, ce_it);
+	zval ctor_ret;
+	ZVAL_UNDEF(&ctor_ret);
+	zend_call_known_instance_method_with_1_params(
+		ce_it->constructor, Z_OBJ_P(return_value), &ctor_ret, &arr);
+	zval_ptr_dtor(&ctor_ret);
+	zval_ptr_dtor(&arr);
+}
+
+/* ---------------- operators ---------------- */
+
+static zend_result pv_do_operation(uint8_t opcode, zval *result, zval *op1, zval *op2)
+{
+	if (opcode == ZEND_ADD
+	 && Z_TYPE_P(op1) == IS_OBJECT && Z_OBJCE_P(op1) == zend_ce_persistent_vector
+	 && Z_TYPE_P(op2) == IS_OBJECT && Z_OBJCE_P(op2) == zend_ce_persistent_vector) {
+		pv_builder b;
+		pv_builder_init(&b);
+		pv_concat_into(&b, Z_PVVEC_P(op1));
+		pv_concat_into(&b, Z_PVVEC_P(op2));
+		pv_make(result, &b.root, b.size, b.shift);
+		return SUCCESS;
+	}
+	return FAILURE;
+}
+
+/* ================= Map (hash-array-mapped trie) ================= */
+
+ZEND_API zend_class_entry *zend_ce_persistent_map;
+
+/* MAP_LEVELS internal trie levels (5 bits each) then a real assoc-array bucket
+ * keyed by the actual key. Fixed depth -> O(1) expected get/set. */
+#define MAP_LEVELS 5
+
+typedef struct {
+	zval        root;   /* IS_ARRAY: trie root */
+	uint32_t    size;
+	zend_object std;
+} pv_map;
+
+static zend_object_handlers pv_map_handlers;
+
+static zend_always_inline pv_map *map_from_obj(zend_object *obj)
+{
+	return (pv_map *)((char *)(obj) - XtOffsetOf(pv_map, std));
+}
+#define Z_PVMAP_P(zv) map_from_obj(Z_OBJ_P(zv))
+
+static zend_object *pv_map_create(zend_class_entry *ce)
+{
+	pv_map *m = zend_object_alloc(sizeof(pv_map), ce);
+	zend_object_std_init(&m->std, ce);
+	object_properties_init(&m->std, ce);
+	ZVAL_ARR(&m->root, zend_new_array(0));
+	m->size = 0;
+	m->std.handlers = &pv_map_handlers;
+	return &m->std;
+}
+
+static void pv_map_free(zend_object *obj)
+{
+	pv_map *m = map_from_obj(obj);
+	zval_ptr_dtor(&m->root);
+	zend_object_std_dtor(&m->std);
+}
+
+static zend_object *pv_map_clone(zend_object *obj)
+{
+	pv_map *src = map_from_obj(obj);
+	zend_object *new_obj = pv_map_create(obj->ce);
+	pv_map *dst = map_from_obj(new_obj);
+	zval_ptr_dtor(&dst->root);
+	ZVAL_COPY(&dst->root, &src->root);
+	dst->size = src->size;
+	return new_obj;
+}
+
+static HashTable *pv_map_get_gc(zend_object *obj, zval **table, int *n)
+{
+	pv_map *m = map_from_obj(obj);
+	*table = &m->root;
+	*n = 1;
+	return NULL;
+}
+
+static void pv_map_make(zval *out, zval *root, uint32_t size)
+{
+	object_init_ex(out, zend_ce_persistent_map);
+	pv_map *m = Z_PVMAP_P(out);
+	zval_ptr_dtor(&m->root);
+	ZVAL_COPY_VALUE(&m->root, root);
+	m->size = size;
+}
+
+static zend_ulong map_key_hash(const zval *key)
+{
+	if (Z_TYPE_P(key) == IS_LONG) {
+		return (zend_ulong) Z_LVAL_P(key);
+	}
+	return zend_string_hash_val(Z_STR_P(key));
+}
+
+static zval *trie_lookup(zend_array *root, const zval *key)
+{
+	zend_ulong h = map_key_hash(key);
+	zend_array *node = root;
+	for (int d = 0; d < MAP_LEVELS; d++) {
+		zval *childz = zend_hash_index_find(node, (h >> (5 * d)) & PV_MASK);
+		if (!childz) {
+			return NULL;
+		}
+		node = Z_ARR_P(childz);
+	}
+	if (Z_TYPE_P(key) == IS_LONG) {
+		return zend_hash_index_find(node, (zend_ulong) Z_LVAL_P(key));
+	}
+	return zend_hash_find(node, Z_STR_P(key));
+}
+
+/* path-copy insert/update; *delta gets +1 if a new key was added */
+static zend_array *map_assoc(zend_array *node, int depth, zend_ulong h, zval *key, zval *val, int *delta)
+{
+	zend_array *copy = node ? zend_array_dup(node) : zend_new_array(0);
+	if (depth == MAP_LEVELS) {
+		bool existed;
+		if (Z_TYPE_P(key) == IS_LONG) {
+			existed = zend_hash_index_exists(copy, (zend_ulong) Z_LVAL_P(key));
+			Z_TRY_ADDREF_P(val);
+			zend_hash_index_update(copy, (zend_ulong) Z_LVAL_P(key), val);
+		} else {
+			existed = zend_hash_exists(copy, Z_STR_P(key));
+			Z_TRY_ADDREF_P(val);
+			zend_hash_update(copy, Z_STR_P(key), val);
+		}
+		if (!existed) {
+			(*delta)++;
+		}
+		return copy;
+	}
+	uint32_t slot = (h >> (5 * depth)) & PV_MASK;
+	zval *childz = node ? zend_hash_index_find(node, slot) : NULL;
+	zend_array *child = childz ? Z_ARR_P(childz) : NULL;
+	zend_array *newchild = map_assoc(child, depth + 1, h, key, val, delta);
+	zval cz;
+	ZVAL_ARR(&cz, newchild);
+	zend_hash_index_update(copy, slot, &cz);
+	return copy;
+}
+
+/* path-copy delete; *delta gets -1 if a key was removed */
+static zend_array *map_dissoc(zend_array *node, int depth, zend_ulong h, const zval *key, int *delta)
+{
+	zend_array *copy = zend_array_dup(node);
+	if (depth == MAP_LEVELS) {
+		zend_result r;
+		if (Z_TYPE_P(key) == IS_LONG) {
+			r = zend_hash_index_del(copy, (zend_ulong) Z_LVAL_P(key));
+		} else {
+			r = zend_hash_del(copy, Z_STR_P(key));
+		}
+		if (r == SUCCESS) {
+			(*delta)--;
+		}
+		return copy;
+	}
+	uint32_t slot = (h >> (5 * depth)) & PV_MASK;
+	zval *childz = zend_hash_index_find(node, slot);
+	if (!childz) {
+		return copy; /* key absent */
+	}
+	zend_array *newchild = map_dissoc(Z_ARR_P(childz), depth + 1, h, key, delta);
+	if (zend_hash_num_elements(newchild) == 0) {
+		zend_array_release(newchild);
+		zend_hash_index_del(copy, slot);
+	} else {
+		zval cz;
+		ZVAL_ARR(&cz, newchild);
+		zend_hash_index_update(copy, slot, &cz);
+	}
+	return copy;
+}
+
+/* walk every bucket, calling cb(key_zval, val) for each entry */
+typedef void (*map_visit_cb)(zval *key, zval *val, void *ctx);
+
+static void map_walk(zend_array *node, int depth, map_visit_cb cb, void *ctx)
+{
+	if (depth == MAP_LEVELS) {
+		zend_string *skey;
+		zend_ulong nkey;
+		zval *val;
+		ZEND_HASH_FOREACH_KEY_VAL(node, nkey, skey, val) {
+			zval k;
+			if (skey) {
+				ZVAL_STR(&k, skey);
+			} else {
+				ZVAL_LONG(&k, (zend_long) nkey);
+			}
+			cb(&k, val, ctx);
+		} ZEND_HASH_FOREACH_END();
+		return;
+	}
+	zval *childz;
+	ZEND_HASH_FOREACH_VAL(node, childz) {
+		map_walk(Z_ARR_P(childz), depth + 1, cb, ctx);
+	} ZEND_HASH_FOREACH_END();
+}
+
+static void map_collect_assoc_cb(zval *key, zval *val, void *ctx)
+{
+	zend_array *out = (zend_array *) ctx;
+	Z_TRY_ADDREF_P(val);
+	if (Z_TYPE_P(key) == IS_LONG) {
+		zend_hash_index_update(out, (zend_ulong) Z_LVAL_P(key), val);
+	} else {
+		zend_hash_update(out, Z_STR_P(key), val);
+	}
+}
+
+static void map_to_assoc(pv_map *m, zval *out)
+{
+	zend_array *arr = zend_new_array(m->size);
+	if (m->size) {
+		map_walk(Z_ARR(m->root), 0, map_collect_assoc_cb, arr);
+	}
+	ZVAL_ARR(out, arr);
+}
+
+/* builder for map/filter/fromArray */
+typedef struct { zval root; uint32_t size; } map_builder;
+
+static void map_builder_init(map_builder *b)
+{
+	ZVAL_ARR(&b->root, zend_new_array(0));
+	b->size = 0;
+}
+
+static void map_builder_set(map_builder *b, zval *key, zval *val)
+{
+	int delta = 0;
+	zend_ulong h = map_key_hash(key);
+	zend_array *newroot = map_assoc(Z_ARR(b->root), 0, h, key, val, &delta);
+	zval_ptr_dtor(&b->root);
+	ZVAL_ARR(&b->root, newroot);
+	b->size += delta;
+}
+
+static void map_load_from_array(map_builder *b, zend_array *arr)
+{
+	zend_string *skey;
+	zend_ulong nkey;
+	zval *val;
+	ZEND_HASH_FOREACH_KEY_VAL(arr, nkey, skey, val) {
+		zval k;
+		if (skey) {
+			ZVAL_STR(&k, skey);
+		} else {
+			ZVAL_LONG(&k, (zend_long) nkey);
+		}
+		ZVAL_DEREF(val);
