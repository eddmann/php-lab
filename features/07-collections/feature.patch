+	pv_map_handlers.offset = XtOffsetOf(pv_map, std);
+	pv_map_handlers.free_obj = pv_map_free;
+	pv_map_handlers.clone_obj = pv_map_clone;
+	pv_map_handlers.get_gc = pv_map_get_gc;
+
+	zend_ce_persistent_set = register_class_Set(
+		zend_ce_aggregate, zend_ce_countable, zend_ce_stringable);
+	zend_ce_persistent_set->create_object = pv_set_create;
+
+	memcpy(&pv_set_handlers, &std_object_handlers, sizeof(zend_object_handlers));
+	pv_set_handlers.offset = XtOffsetOf(pv_set, std);
+	pv_set_handlers.free_obj = pv_set_free;
+	pv_set_handlers.clone_obj = pv_set_clone;
+	pv_set_handlers.get_gc = pv_set_get_gc;
+	pv_set_handlers.do_operation = pv_set_do_operation;
