+ZEND_METHOD(Map, map)
+{
+	zend_fcall_info fci;
+	zend_fcall_info_cache fcc;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_FUNC(fci, fcc)
+	ZEND_PARSE_PARAMETERS_END();
+
+	pv_map *m = Z_PVMAP_P(ZEND_THIS);
+	zval assoc;
+	map_to_assoc(m, &assoc);
+
+	map_builder b;
+	map_builder_init(&b);
+	zend_string *skey;
+	zend_ulong nkey;
+	zval *val;
+	ZEND_HASH_FOREACH_KEY_VAL(Z_ARRVAL(assoc), nkey, skey, val) {
+		zval k, ret, args[2];
+		if (skey) { ZVAL_STR(&k, skey); } else { ZVAL_LONG(&k, (zend_long) nkey); }
+		ZVAL_COPY(&args[0], val);
+		ZVAL_COPY(&args[1], &k);
+		fci.param_count = 2;
+		fci.params = args;
+		fci.retval = &ret;
+		fci.named_params = NULL;
+		zend_result r = zend_call_function(&fci, &fcc);
+		zval_ptr_dtor(&args[0]);
+		zval_ptr_dtor(&args[1]);
+		if (r == SUCCESS && !EG(exception)) {
+			map_builder_set(&b, &k, &ret);
+		}
+		zval_ptr_dtor(&ret);
+		if (EG(exception)) { break; }
+	} ZEND_HASH_FOREACH_END();
+	zval_ptr_dtor(&assoc);
+	if (EG(exception)) { zval_ptr_dtor(&b.root); RETURN_THROWS(); }
+	pv_map_make(return_value, &b.root, b.size);
+}
