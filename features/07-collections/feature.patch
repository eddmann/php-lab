+}
+
+ZEND_METHOD(Set, __toString)
+{
+	ZEND_PARSE_PARAMETERS_NONE();
+	pv_set *s = Z_PVSET_P(ZEND_THIS);
+	smart_str buf = {0};
+	smart_str_appends(&buf, "Set(");
+	if (s->size) {
+		zval list;
+		set_to_list(s, &list);
+		bool first = true;
+		zval *m;
+		ZEND_HASH_FOREACH_VAL(Z_ARRVAL(list), m) {
+			if (!first) smart_str_appends(&buf, ", ");
+			first = false;
+			pv_append_scalar(&buf, m);
+		} ZEND_HASH_FOREACH_END();
+		zval_ptr_dtor(&list);
+	}
+	smart_str_appendc(&buf, ')');
+	smart_str_0(&buf);
+	RETURN_STR(smart_str_extract(&buf));
+}
+
+ZEND_METHOD(Set, getIterator)
+{
+	ZEND_PARSE_PARAMETERS_NONE();
+	zval arr;
+	set_to_list(Z_PVSET_P(ZEND_THIS), &arr);
+	zend_string *name = zend_string_init("ArrayIterator", sizeof("ArrayIterator") - 1, 0);
+	zend_class_entry *ce_it = zend_lookup_class(name);
+	zend_string_release(name);
+	if (!ce_it) {
+		zval_ptr_dtor(&arr);
+		zend_throw_error(NULL, "ArrayIterator is not available");
+		RETURN_THROWS();
+	}
+	object_init_ex(return_value, ce_it);
+	zval ctor_ret;
+	ZVAL_UNDEF(&ctor_ret);
+	zend_call_known_instance_method_with_1_params(ce_it->constructor, Z_OBJ_P(return_value), &ctor_ret, &arr);
+	zval_ptr_dtor(&ctor_ret);
+	zval_ptr_dtor(&arr);
+}
+
+static zend_result pv_set_do_operation(uint8_t opcode, zval *result, zval *op1, zval *op2)
+{
+	if (Z_TYPE_P(op1) == IS_OBJECT && Z_OBJCE_P(op1) == zend_ce_persistent_set
+	 && Z_TYPE_P(op2) == IS_OBJECT && Z_OBJCE_P(op2) == zend_ce_persistent_set) {
+		pv_set *a = Z_PVSET_P(op1), *b = Z_PVSET_P(op2);
+		switch (opcode) {
+			case ZEND_BW_OR:  set_union(result, a, b);     return SUCCESS;
+			case ZEND_BW_AND: set_intersect(result, a, b); return SUCCESS;
+			case ZEND_SUB:    set_diff(result, a, b);      return SUCCESS;
+			default: break;
+		}
+	}
+	return FAILURE;
+}
