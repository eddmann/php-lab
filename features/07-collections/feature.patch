+/* ================= Set (HAMT of unique members) ================= */
+
+ZEND_API zend_class_entry *zend_ce_persistent_set;
+
+typedef struct {
+	zval        root;   /* IS_ARRAY: trie root, member stored as both key and value */
+	uint32_t    size;
+	zend_object std;
+} pv_set;
+
+static zend_object_handlers pv_set_handlers;
+
+static zend_always_inline pv_set *set_from_obj(zend_object *obj)
+{
+	return (pv_set *)((char *)(obj) - XtOffsetOf(pv_set, std));
+}
+#define Z_PVSET_P(zv) set_from_obj(Z_OBJ_P(zv))
+
+static zend_object *pv_set_create(zend_class_entry *ce)
+{
+	pv_set *s = zend_object_alloc(sizeof(pv_set), ce);
+	zend_object_std_init(&s->std, ce);
+	object_properties_init(&s->std, ce);
+	ZVAL_ARR(&s->root, zend_new_array(0));
+	s->size = 0;
+	s->std.handlers = &pv_set_handlers;
+	return &s->std;
+}
+
+static void pv_set_free(zend_object *obj)
+{
+	pv_set *s = set_from_obj(obj);
+	zval_ptr_dtor(&s->root);
+	zend_object_std_dtor(&s->std);
+}
+
+static zend_object *pv_set_clone(zend_object *obj)
+{
+	pv_set *src = set_from_obj(obj);
+	zend_object *new_obj = pv_set_create(obj->ce);
+	pv_set *dst = set_from_obj(new_obj);
+	zval_ptr_dtor(&dst->root);
+	ZVAL_COPY(&dst->root, &src->root);
+	dst->size = src->size;
+	return new_obj;
+}
+
+static HashTable *pv_set_get_gc(zend_object *obj, zval **table, int *n)
+{
+	pv_set *s = set_from_obj(obj);
+	*table = &s->root;
+	*n = 1;
+	return NULL;
+}
+
+static void pv_set_make(zval *out, zval *root, uint32_t size)
+{
+	object_init_ex(out, zend_ce_persistent_set);
+	pv_set *s = Z_PVSET_P(out);
+	zval_ptr_dtor(&s->root);
+	ZVAL_COPY_VALUE(&s->root, root);
+	s->size = size;
+}
+
+static bool set_valid_member(const zval *m)
+{
+	return Z_TYPE_P(m) == IS_LONG || Z_TYPE_P(m) == IS_STRING;
+}
+
+/* builder: stores each member as both key and value in the HAMT */
+typedef struct { zval root; uint32_t size; } set_builder;
+
+static void set_builder_init(set_builder *b)
+{
+	ZVAL_ARR(&b->root, zend_new_array(0));
+	b->size = 0;
+}
+
+static void set_builder_add(set_builder *b, zval *member)
+{
+	int delta = 0;
+	zend_array *newroot = map_assoc(Z_ARR(b->root), 0, map_key_hash(member), member, member, &delta);
+	zval_ptr_dtor(&b->root);
+	ZVAL_ARR(&b->root, newroot);
+	b->size += delta;
+}
+
+static void set_collect_cb(zval *key, zval *val, void *ctx)
+{
+	(void) key;
+	Z_TRY_ADDREF_P(val);
+	zend_hash_next_index_insert((zend_array *) ctx, val);
+}
+
+static void set_to_list(pv_set *s, zval *out)
+{
+	zend_array *arr = zend_new_array(s->size);
+	if (s->size) {
+		map_walk(Z_ARR(s->root), 0, set_collect_cb, arr);
+	}
+	ZVAL_ARR(out, arr);
+}
+
+ZEND_METHOD(Set, __construct)
+{
+	zval *members = NULL;
+	ZEND_PARSE_PARAMETERS_START(0, 1)
+		Z_PARAM_OPTIONAL
+		Z_PARAM_ARRAY(members)
+	ZEND_PARSE_PARAMETERS_END();
+
+	if (!members || zend_hash_num_elements(Z_ARRVAL_P(members)) == 0) {
+		return;
+	}
+	pv_set *self = Z_PVSET_P(ZEND_THIS);
+	set_builder b;
+	set_builder_init(&b);
+	zval *m;
+	ZEND_HASH_FOREACH_VAL(Z_ARRVAL_P(members), m) {
+		ZVAL_DEREF(m);
+		if (!set_valid_member(m)) {
+			zval_ptr_dtor(&b.root);
+			zend_argument_type_error(1, "must contain only string|int members");
+			RETURN_THROWS();
+		}
+		set_builder_add(&b, m);
+	} ZEND_HASH_FOREACH_END();
+	zval_ptr_dtor(&self->root);
+	ZVAL_COPY_VALUE(&self->root, &b.root);
+	self->size = b.size;
+}
+
+ZEND_METHOD(Set, of)
+{
+	zval *args;
+	uint32_t argc;
+	ZEND_PARSE_PARAMETERS_START(0, -1)
+		Z_PARAM_VARIADIC('+', args, argc)
+	ZEND_PARSE_PARAMETERS_END();
+
+	set_builder b;
+	set_builder_init(&b);
+	for (uint32_t i = 0; i < argc; i++) {
+		if (!set_valid_member(&args[i])) {
+			zval_ptr_dtor(&b.root);
+			zend_argument_type_error(i + 1, "must be of type string|int");
+			RETURN_THROWS();
+		}
+		set_builder_add(&b, &args[i]);
+	}
+	pv_set_make(return_value, &b.root, b.size);
+}
+
+ZEND_METHOD(Set, fromArray)
+{
+	zval *arr;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_ARRAY(arr)
+	ZEND_PARSE_PARAMETERS_END();
+	set_builder b;
+	set_builder_init(&b);
+	zval *m;
+	ZEND_HASH_FOREACH_VAL(Z_ARRVAL_P(arr), m) {
+		ZVAL_DEREF(m);
+		if (!set_valid_member(m)) {
+			zval_ptr_dtor(&b.root);
+			zend_argument_type_error(1, "must contain only string|int members");
+			RETURN_THROWS();
+		}
+		set_builder_add(&b, m);
+	} ZEND_HASH_FOREACH_END();
+	pv_set_make(return_value, &b.root, b.size);
+}
+
+ZEND_METHOD(Set, count)
+{
+	ZEND_PARSE_PARAMETERS_NONE();
+	RETURN_LONG(Z_PVSET_P(ZEND_THIS)->size);
+}
+
+ZEND_METHOD(Set, isEmpty)
+{
+	ZEND_PARSE_PARAMETERS_NONE();
+	RETURN_BOOL(Z_PVSET_P(ZEND_THIS)->size == 0);
+}
+
+ZEND_METHOD(Set, has)
+{
+	zval *m;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_ZVAL(m)
+	ZEND_PARSE_PARAMETERS_END();
+	if (!set_valid_member(m)) {
+		zend_argument_type_error(1, "must be of type string|int");
+		RETURN_THROWS();
+	}
+	RETURN_BOOL(trie_lookup(Z_ARR(Z_PVSET_P(ZEND_THIS)->root), m) != NULL);
+}
+
+ZEND_METHOD(Set, add)
+{
+	zval *m;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_ZVAL(m)
+	ZEND_PARSE_PARAMETERS_END();
+	if (!set_valid_member(m)) {
+		zend_argument_type_error(1, "must be of type string|int");
+		RETURN_THROWS();
+	}
+	pv_set *s = Z_PVSET_P(ZEND_THIS);
+	int delta = 0;
+	zend_array *newroot = map_assoc(Z_ARR(s->root), 0, map_key_hash(m), m, m, &delta);
+	zval rootz;
+	ZVAL_ARR(&rootz, newroot);
+	pv_set_make(return_value, &rootz, s->size + delta);
+}
+
+ZEND_METHOD(Set, remove)
+{
+	zval *m;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_ZVAL(m)
+	ZEND_PARSE_PARAMETERS_END();
+	if (!set_valid_member(m)) {
+		zend_argument_type_error(1, "must be of type string|int");
+		RETURN_THROWS();
+	}
+	pv_set *s = Z_PVSET_P(ZEND_THIS);
+	int delta = 0;
+	zend_array *newroot = map_dissoc(Z_ARR(s->root), 0, map_key_hash(m), m, &delta);
+	zval rootz;
+	ZVAL_ARR(&rootz, newroot);
+	pv_set_make(return_value, &rootz, s->size + delta);
+}
+
+/* add every member of `s` into builder `b` */
+static void set_add_all(set_builder *b, pv_set *s)
+{
+	if (s->size == 0) {
+		return;
+	}
+	zval list;
+	set_to_list(s, &list);
+	zval *m;
+	ZEND_HASH_FOREACH_VAL(Z_ARRVAL(list), m) {
+		set_builder_add(b, m);
+	} ZEND_HASH_FOREACH_END();
+	zval_ptr_dtor(&list);
+}
+
+static void set_union(zval *out, pv_set *a, pv_set *b)
+{
+	set_builder bld;
+	set_builder_init(&bld);
+	set_add_all(&bld, a);
+	set_add_all(&bld, b);
+	pv_set_make(out, &bld.root, bld.size);
+}
+
+static void set_intersect(zval *out, pv_set *a, pv_set *b)
+{
+	set_builder bld;
+	set_builder_init(&bld);
+	if (a->size) {
+		zval list;
+		set_to_list(a, &list);
+		zval *m;
+		ZEND_HASH_FOREACH_VAL(Z_ARRVAL(list), m) {
+			if (trie_lookup(Z_ARR(b->root), m)) {
+				set_builder_add(&bld, m);
+			}
+		} ZEND_HASH_FOREACH_END();
+		zval_ptr_dtor(&list);
+	}
+	pv_set_make(out, &bld.root, bld.size);
+}
+
+static void set_diff(zval *out, pv_set *a, pv_set *b)
+{
+	set_builder bld;
+	set_builder_init(&bld);
+	if (a->size) {
+		zval list;
+		set_to_list(a, &list);
+		zval *m;
+		ZEND_HASH_FOREACH_VAL(Z_ARRVAL(list), m) {
+			if (!trie_lookup(Z_ARR(b->root), m)) {
+				set_builder_add(&bld, m);
+			}
+		} ZEND_HASH_FOREACH_END();
+		zval_ptr_dtor(&list);
+	}
+	pv_set_make(out, &bld.root, bld.size);
+}
+
+ZEND_METHOD(Set, union)
+{
+	zval *other;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_OBJECT_OF_CLASS(other, zend_ce_persistent_set)
+	ZEND_PARSE_PARAMETERS_END();
+	set_union(return_value, Z_PVSET_P(ZEND_THIS), Z_PVSET_P(other));
+}
+
+ZEND_METHOD(Set, intersect)
+{
+	zval *other;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
+		Z_PARAM_OBJECT_OF_CLASS(other, zend_ce_persistent_set)
+	ZEND_PARSE_PARAMETERS_END();
+	set_intersect(return_value, Z_PVSET_P(ZEND_THIS), Z_PVSET_P(other));
+}
+
+ZEND_METHOD(Set, diff)
+{
+	zval *other;
+	ZEND_PARSE_PARAMETERS_START(1, 1)
