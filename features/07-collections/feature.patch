+/**
+ * An immutable, persistent ordered sequence backed by a bit-partitioned trie
+ * (branching factor 32). Every "mutation" returns a new Vector that shares
+ * structure with the original, so updates are O(log32 n) and the original is
+ * never changed.
+ */
+final class Vector implements IteratorAggregate, Countable, Stringable
+{
+    public function __construct(array $values = []) {}
+    public static function of(mixed ...$values): Vector {}
+    public static function fromArray(array $values): Vector {}
+
+    public function count(): int {}
+    public function isEmpty(): bool {}
+    public function get(int $index): mixed {}
+    public function first(): mixed {}
+    public function last(): mixed {}
+
+    public function push(mixed $value): Vector {}
+    public function pop(): Vector {}
+    public function set(int $index, mixed $value): Vector {}
+
+    public function map(callable $fn): Vector {}
+    public function filter(callable $fn): Vector {}
+    public function reduce(callable $fn, mixed $initial = null): mixed {}
+    public function slice(int $offset, ?int $length = null): Vector {}
+    public function concat(Vector $other): Vector {}
+
+    public function toArray(): array {}
+    public function getIterator(): Iterator {}
+    public function __toString(): string {}
+}
+
+/**
+ * An immutable, persistent key/value map backed by a hash-array-mapped trie
+ * (HAMT). Keys are int or string. Every "mutation" returns a new Map that shares
+ * structure with the original (O(1) expected updates). Iteration order is the
+ * trie's hash order, not insertion order.
+ */
+final class Map implements IteratorAggregate, Countable, Stringable
+{
+    public function __construct(array $entries = []) {}
+    public static function fromArray(array $entries): Map {}
+
+    public function count(): int {}
+    public function isEmpty(): bool {}
+    public function has(string|int $key): bool {}
+    public function get(string|int $key, mixed $default = null): mixed {}
+
+    public function set(string|int $key, mixed $value): Map {}
+    public function remove(string|int $key): Map {}
+
+    public function keys(): array {}
+    public function values(): array {}
+    public function map(callable $fn): Map {}
+    public function filter(callable $fn): Map {}
+
+    public function toArray(): array {}
+    public function getIterator(): Iterator {}
+    public function __toString(): string {}
+}
+
+/**
+ * An immutable, persistent set of unique int/string members backed by the same
+ * HAMT as Map. Every "mutation" returns a new Set sharing structure with the
+ * original. The `|`, `&` and `-` operators are union, intersection and
+ * difference. Iteration order is the trie's hash order.
+ */
+final class Set implements IteratorAggregate, Countable, Stringable
+{
+    public function __construct(array $members = []) {}
+    public static function of(mixed ...$members): Set {}
+    public static function fromArray(array $members): Set {}
+
+    public function count(): int {}
+    public function isEmpty(): bool {}
+    public function has(string|int $member): bool {}
+
+    public function add(string|int $member): Set {}
+    public function remove(string|int $member): Set {}
+
+    public function union(Set $other): Set {}
+    public function intersect(Set $other): Set {}
+    public function diff(Set $other): Set {}
+
+    public function map(callable $fn): Set {}
+    public function filter(callable $fn): Set {}
+
+    public function toArray(): array {}
+    public function getIterator(): Iterator {}
+    public function __toString(): string {}
+}
