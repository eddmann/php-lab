+	pv_map *m = Z_PVMAP_P(ZEND_THIS);
+	smart_str buf = {0};
+	smart_str_appends(&buf, "Map(");
+	map_str_ctx ctx = { &buf, true };
+	if (m->size) {
+		map_walk(Z_ARR(m->root), 0, map_tostring_cb, &ctx);
+	}
+	smart_str_appendc(&buf, ')');
+	smart_str_0(&buf);
+	RETURN_STR(smart_str_extract(&buf));
+}
