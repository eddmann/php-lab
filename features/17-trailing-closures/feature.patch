+/* Trailing closures (Swift / Ruby blocks): `f(args) { |$x| body }` appends the
+ * block to the call's argument list as an auto-capturing closure. The block is
+ * built as an arrow function with a statement-list body, so surrounding
+ * variables are imported by value via the usual implicit-binds machinery. */
+static zend_ast *zend_ast_append_trailing_block(zend_ast *args, zend_ast *block) {
+	/* `f(...)` first-class callable syntax produces a bare CALLABLE_CONVERT
+	 * node rather than an argument list — there is no call to attach to. */
+	if (args->kind == ZEND_AST_CALLABLE_CONVERT) {
+		zend_error_noreturn(E_COMPILE_ERROR,
+			"Cannot combine first-class callable syntax with a trailing closure");
+	}
+	return zend_ast_list_add(args, block);
+}
+
 #ifdef _MSC_VER
 #define YYMALLOC malloc
 #define YYFREE free
